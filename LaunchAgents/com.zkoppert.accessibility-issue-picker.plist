<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zkoppert.accessibility-issue-picker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/zkoppert/.local/bin/accessibility-issue-picker</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/Users/zkoppert/Library/Logs/accessibility-issue-picker.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zkoppert/Library/Logs/accessibility-issue-picker.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/zkoppert</string>
    </dict>
</dict>
</plist>
