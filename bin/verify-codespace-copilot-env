#!/usr/bin/env python3
"""Verify the Copilot CLI environment in a GitHub Codespace."""

from __future__ import annotations

import json
import os
import runpy
import shutil
import subprocess
from pathlib import Path

REQUIRED_SKILLS = {
    "actions-security",
    "cleanup-worktrees",
    "code-review-workflow",
    "engineering-practices",
    "feature-flag-rollout",
    "gh-axi",
    "github-operations",
    "graphql-availability-investigator",
    "memory-sweep",
    "milestone-release-tracking",
    "nux-fr-handoff",
    "open-source-actions-maintenance",
    "pr-body-render-check",
    "prod-explain",
    "pull-request-workflow",
    "record-demo",
    "remediate-accessibility-audit",
    "session-portability",
    "spreadsheet-report-generation",
    "test-quality",
    "triage-dependabot",
    "triage-notifications",
    "ui-screenshot-presentation",
    "validate-pr-with-codespace",
    "validate-style",
}
MANAGED_MCP_SERVERS = runpy.run_path(
    str(Path(__file__).resolve().with_name("bootstrap-copilot-mcp"))
)["MCP_SERVERS"]
REQUIRED_TOOLS = {
    "1up",
    "az",
    "copilot",
    "docker",
    "gh",
    "node",
    "npx",
    "pi",
    "tailscale",
    "tmux",
}
REQUIRED_ENVIRONMENT = {
    "COPILOT_SKILL_CATALOG_REPO",
    "COPILOT_MCP_SPLUNK_BEARER_TOKEN",
    "COPILOT_MCP_SPLUNK_HOST",
}
SKILL_METADATA = runpy.run_path(
    str(Path(__file__).resolve().parents[1] / "scripts" / "skill_metadata.py")
)
pi_sdk_path = SKILL_METADATA["pi_sdk_path"]
skill_metadata_errors = SKILL_METADATA["skill_metadata_errors"]


def command_succeeds(command: list[str]) -> bool:
    """Return whether a command exits successfully."""
    try:
        return (
            subprocess.run(
                command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            ).returncode
            == 0
        )
    except FileNotFoundError:
        return False


def effective_pi_skills(agent_dir: Path) -> dict[str, dict]:
    sdk = pi_sdk_path()
    script = r"""
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
const { DefaultResourceLoader, SettingsManager } = await import(pathToFileURL(process.argv[1]).href);
const agentDir = process.argv[2];
const settingsPath = join(agentDir, 'settings.json');
const settings = existsSync(settingsPath)
    ? JSON.parse(readFileSync(settingsPath, 'utf8').replace(/^\uFEFF/, '')) : {};
const loader = new DefaultResourceLoader({
    cwd: process.cwd(),
    agentDir,
    settingsManager: SettingsManager.inMemory(settings, { projectTrusted: false }),
    noExtensions: true,
    noPromptTemplates: true,
    noThemes: true,
    noContextFiles: true,
});
await loader.reload();
console.log(JSON.stringify(loader.getSkills().skills.map(({ name, filePath, disableModelInvocation }) =>
    ({ name, filePath, disableModelInvocation }))));
"""
    try:
        result = subprocess.run(
            ["node", "--input-type=module", "-e", script, str(sdk), str(agent_dir)],
            env={**os.environ, "PI_OFFLINE": "1"},
            capture_output=True,
            text=True,
            check=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise ValueError("Pi SDK discovery failed; check the installed Pi and Node.js versions") from error
    skills = json.loads(result.stdout)
    if not isinstance(skills, list) or any(
        not isinstance(skill, dict)
        or not isinstance(skill.get("name"), str)
        or not isinstance(skill.get("filePath"), str)
        or not Path(skill["filePath"]).is_absolute()
        or not isinstance(skill.get("disableModelInvocation"), bool)
        for skill in skills
    ):
        raise ValueError("Pi SDK returned an invalid skill inventory")
    winners = {skill["name"]: skill for skill in skills}
    if len(winners) != len(skills):
        raise ValueError("Pi SDK returned duplicate skill winners")
    return winners


def main() -> int:
    """Print a safe environment report and return nonzero when incomplete."""
    failures: list[str] = []

    if (
        os.environ.get("CODESPACES") != "true"
        and not Path("/workspaces/.codespaces").exists()
    ):
        failures.append("not running in a GitHub Codespace")

    missing_tools = sorted(
        tool for tool in REQUIRED_TOOLS if shutil.which(tool) is None
    )
    if missing_tools:
        failures.append(f"missing tools: {', '.join(missing_tools)}")

    dotfiles_root = Path(__file__).resolve().parents[1]
    expected_hooks_path = (
        Path.home() / ".local" / "share" / "dotfiles-git-hooks"
    ).resolve()
    try:
        hooks_path = subprocess.run(
            ["git", "config", "--get", "core.hooksPath"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        if Path(hooks_path).expanduser().resolve() != expected_hooks_path:
            failures.append(
                f"core.hooksPath must point to {expected_hooks_path} (found {hooks_path})"
            )
    except (OSError, subprocess.CalledProcessError):
        failures.append(f"core.hooksPath is not configured for {expected_hooks_path}")
    forwarded_hook_names = {
        "applypatch-msg",
        "pre-applypatch",
        "post-applypatch",
        "pre-merge-commit",
        "prepare-commit-msg",
        "commit-msg",
        "post-commit",
        "pre-rebase",
        "post-checkout",
        "post-merge",
        "post-rewrite",
        "post-index-change",
        "pre-auto-gc",
        "reference-transaction",
        "sendemail-validate",
        "fsmonitor-watchman",
        "p4-changelist",
        "p4-prepare-changelist",
        "p4-post-changelist",
        "p4-pre-submit",
    }
    required_paths = {
        expected_hooks_path / "pre-push",
        expected_hooks_path / "pre-commit",
        dotfiles_root / "bin" / "pr-size-guard",
        *(expected_hooks_path / name for name in forwarded_hook_names),
    }
    for required_path in required_paths:
        if not required_path.is_file() or not os.access(required_path, os.X_OK):
            failures.append(f"PR size guard is missing or not executable: {required_path}")
    expected_hook_targets = {
        expected_hooks_path / "pre-push": dotfiles_root / "git-hooks" / "pre-push",
        expected_hooks_path / "pre-commit": dotfiles_root / "git-hooks" / "pre-commit",
        **{
            expected_hooks_path / name: (
                dotfiles_root / "git-hooks" / "repository-hook-forwarder"
            )
            for name in forwarded_hook_names
        },
    }
    for hook_path, expected_target in expected_hook_targets.items():
        if not hook_path.is_symlink() or hook_path.resolve() != expected_target:
            failures.append(f"managed Git hook has the wrong target: {hook_path}")

    expected_gh_guard = dotfiles_root / "bin" / "gh-guard"
    expected_pr_marker = dotfiles_root / "bin" / "pr-marker"
    installed_gh = Path.home() / ".local" / "bin" / "gh"
    installed_pr_marker = Path.home() / ".local" / "bin" / "pr-marker"
    active_gh = shutil.which("gh")
    active_pr_marker = shutil.which("pr-marker")
    if (
        not installed_gh.is_symlink()
        or installed_gh.resolve() != expected_gh_guard
        or active_gh is None
        or Path(active_gh).resolve() != expected_gh_guard
    ):
        failures.append(
            f"gh must resolve to the personal wrapper at {expected_gh_guard}"
        )
    if (
        not installed_pr_marker.is_symlink()
        or installed_pr_marker.resolve() != expected_pr_marker
        or active_pr_marker is None
        or Path(active_pr_marker).resolve() != expected_pr_marker
    ):
        failures.append(
            f"pr-marker must resolve to the personal helper at {expected_pr_marker}"
        )
    if active_gh and not command_succeeds(["gh", "stack", "--help"]):
        failures.append("missing GitHub extension: github/gh-stack")

    remote_helper = Path.home() / ".local" / "bin" / "copilot-codespace-session"
    if not remote_helper.is_file() or not os.access(remote_helper, os.X_OK):
        failures.append(f"remote helper is missing or not executable: {remote_helper}")

    expected_instructions = dotfiles_root / ".github" / "copilot-instructions.md"
    configured_pi_agent_dir = os.environ.get("PI_CODING_AGENT_DIR")
    if configured_pi_agent_dir and not (
        configured_pi_agent_dir == "~"
        or configured_pi_agent_dir.startswith("~/")
        or Path(configured_pi_agent_dir).is_absolute()
    ):
        failures.append("PI_CODING_AGENT_DIR must be absolute or start with ~/")
        pi_agent_dir = Path.home() / ".pi" / "agent"
    else:
        pi_agent_dir = Path(
            configured_pi_agent_dir or Path.home() / ".pi" / "agent"
        ).expanduser()
    pi_instructions = pi_agent_dir / "AGENTS.md"
    for filename in ("AGENTS.override.md", "AGENTS.md", "AGENTS.MD", "CLAUDE.md", "CLAUDE.MD"):
        candidate = pi_agent_dir / filename
        if candidate.is_file():
            pi_instructions = candidate
            break

    repository_skills = {
        path.parent.name: path.parent
        for path in dotfiles_root.glob(".copilot/skills/*/SKILL.md")
    }
    required_skills = REQUIRED_SKILLS | repository_skills.keys()
    installed_skill_files: dict[Path, tuple[str, str]] = {}

    for client, instructions, skills_dir in (
        (
            "Copilot",
            Path.home() / ".copilot" / "copilot-instructions.md",
            Path.home() / ".copilot" / "skills",
        ),
        (
            "Pi",
            pi_instructions,
            Path.home() / ".agents" / "skills",
        ),
    ):
        if not instructions.is_symlink() or instructions.resolve() != expected_instructions:
            failures.append(
                f"{client} instructions do not resolve to the dotfiles checkout: {instructions}"
            )

        installed_skills = (
            {
                path.name
                for path in skills_dir.iterdir()
                if (path / "SKILL.md").is_file()
            }
            if skills_dir.is_dir()
            else set()
        )
        missing_skills = sorted(required_skills - installed_skills)
        if missing_skills:
            failures.append(f"{client} missing skills: {', '.join(missing_skills)}")

        for name in sorted(required_skills & installed_skills):
            installed_skill_files[skills_dir / name / "SKILL.md"] = (client, name)
            if name in repository_skills:
                source = repository_skills[name]
                owner = "the dotfiles checkout"
            elif client == "Pi":
                source = Path.home() / ".copilot" / "skills" / name
                owner = "the Copilot source"
            else:
                continue
            skill = skills_dir / name
            if skill.resolve() != source.resolve():
                failures.append(f"{client} {name} does not resolve to {owner}: {skill}")
        print(f"{client} installed skills: {len(installed_skills)}")

    try:
        metadata_errors = skill_metadata_errors({
            path: name for path, (_, name) in installed_skill_files.items()
        })
    except (OSError, ValueError) as error:
        failures.append(f"cannot validate installed skill metadata: {error}")
    else:
        for path, (client, name) in installed_skill_files.items():
            failures.extend(f"{client} {name} {error}" for error in metadata_errors[str(path)])

    try:
        pi_skills = effective_pi_skills(pi_agent_dir)
    except (OSError, ValueError) as error:
        failures.append(f"cannot verify Pi effective skills: {error}")
    else:
        missing_effective_skills = sorted(required_skills - pi_skills.keys())
        if missing_effective_skills:
            failures.append(f"Pi effective skills missing: {', '.join(missing_effective_skills)}")
        for name in sorted(required_skills & pi_skills.keys()):
            skill = pi_skills[name]
            source = repository_skills.get(name, Path.home() / ".copilot" / "skills" / name)
            if Path(skill["filePath"]).resolve() != (source / "SKILL.md").resolve():
                failures.append(f"Pi {name} resolves to unexpected skill: {skill['filePath']}")
            if skill["disableModelInvocation"]:
                failures.append(f"Pi {name} is unavailable for model invocation")
        print(f"Pi effective skills: {len(pi_skills)}")

    if "copilot" in missing_tools:
        failures.append("cannot list Copilot plugins")
    else:
        try:
            plugins = json.loads(
                subprocess.run(
                    ["copilot", "plugin", "list", "--json"],
                    capture_output=True,
                    text=True,
                    check=True,
                ).stdout
            )
            if not isinstance(plugins, list):
                raise ValueError("plugin list must be a JSON array")
            if not any(
                isinstance(plugin, dict)
                and plugin.get("name") == "gho11y"
                and plugin.get("enabled") is True
                for plugin in plugins
            ):
                failures.append("missing or disabled Copilot plugin: gho11y")
        except (OSError, subprocess.CalledProcessError, ValueError):
            failures.append("cannot list Copilot plugins")

    mcp_config = Path.home() / ".copilot" / "mcp-config.json"
    configured_servers: set[str] = set()
    try:
        payload = json.loads(mcp_config.read_text(encoding="utf-8"))
        servers = payload.get("mcpServers") if isinstance(payload, dict) else None
        if not isinstance(servers, dict):
            raise ValueError("mcpServers must be a JSON object")
        configured_servers = set(servers)
        for name in sorted(MANAGED_MCP_SERVERS.keys() & configured_servers):
            expected = json.dumps(MANAGED_MCP_SERVERS[name], sort_keys=True)
            if json.dumps(servers[name], sort_keys=True) != expected:
                failures.append(
                    f"invalid MCP server {name}: does not match the managed definition; "
                    "run bootstrap-copilot-mcp"
                )
    except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError):
        failures.append(f"cannot read MCP configuration: {mcp_config}")
    missing_servers = sorted(MANAGED_MCP_SERVERS.keys() - configured_servers)
    if missing_servers:
        failures.append(f"missing MCP servers: {', '.join(missing_servers)}")

    missing_environment = sorted(
        name for name in REQUIRED_ENVIRONMENT if not os.environ.get(name)
    )
    if missing_environment:
        failures.append(
            "missing Codespaces secret environment: "
            f"{', '.join(missing_environment)}"
        )

    if shutil.which("docker") and not command_succeeds(["docker", "info"]):
        failures.append("Docker is installed but unavailable")
    if shutil.which("tailscale") and not command_succeeds(["tailscale", "status"]):
        failures.append("Tailscale is not connected")
    if shutil.which("az") and not command_succeeds(["az", "account", "show"]):
        failures.append("Azure CLI is not authenticated")

    print(f"Configured MCP servers: {len(configured_servers)}")
    print("OAuth status: verify DataDog, Sentry, and Slack with /mcp")
    if failures:
        print("Codespace Copilot environment is incomplete:")
        for failure in failures:
            print(f"  - {failure}")
        return 1

    print("Codespace Copilot environment is ready.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
