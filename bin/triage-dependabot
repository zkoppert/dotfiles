#!/bin/bash
# launchd uses an isolated Python environment and private repository policy.
set -euo pipefail

# launchd does not inherit the interactive Homebrew path.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

find_gh() {
  local candidate
  for candidate in \
    "${TRIAGE_DEPENDABOT_GH:-}" \
    /opt/homebrew/bin/gh \
    /usr/local/bin/gh \
    "$(command -v gh 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      echo "$candidate"
      return
    fi
  done
  echo "triage-dependabot: GitHub CLI is required for CFS package resolution" >&2
  exit 1
}

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUNTIME="$ROOT/.dependabot-runtime"
if [ "${1:-}" = "--prepare-runtime" ]; then
  GH="$(find_gh)"
  umask 077
  /opt/homebrew/bin/uv venv --python /opt/homebrew/bin/python3 "$RUNTIME/python"
  "$GH" cfs -- /opt/homebrew/bin/uv pip install --python "$RUNTIME/python/bin/python" \
    'PyYAML==6.0.3' 'ruamel.yaml==0.18.16'
  "$GH" cfs -- /opt/homebrew/bin/npm install --prefix "$RUNTIME/node" \
    --no-save --ignore-scripts --no-audit --no-fund 'gh-axi@0.1.35'
  exit 0
fi
quiet=false
report=""
expect_report=false
for argument in "$@"; do
  case "$argument" in --dry-run|--help|-h) quiet=true ;; esac
  if "$expect_report"; then
    report="$argument"
    expect_report=false
  else
    case "$argument" in
      --report) expect_report=true ;;
      --report=*) report="${argument#--report=}" ;;
    esac
  fi
done
failure_reported() {
  [ -e "${DEPENDABOT_FAILURE_REPORTED:-}" ] || [ -e "${DEPENDABOT_FALLBACK_ALERT_SENT:-}" ]
}

alert_failure() {
  local status="$1" python last_python=""
  local arguments=(--bootstrap-error "$status")
  if "$quiet"; then return 0; fi
  if [ -e "${DEPENDABOT_WORKER_STARTED:-}" ]; then arguments+=(--worker-started); fi
  if [ -n "$report" ]; then arguments+=(--report "$report"); fi
  for python in /opt/homebrew/bin/python3 "$(command -v python3 || true)" /usr/bin/python3; do
    if [ -x "$python" ] && [ "$python" != "$last_python" ]; then
      last_python="$python"
      if "$python" "$ROOT/scripts/dependabot_alerts.py" "${arguments[@]}"; then return 0; fi
      if failure_reported; then return 1; fi
    fi
  done
  echo "Dependabot failed; the help alert also failed." >&2
  return 1
}

if ! receipt_dir="$(mktemp -d)"; then
  unset DEPENDABOT_WORKER_STARTED DEPENDABOT_FAILURE_REPORTED DEPENDABOT_FALLBACK_ALERT_SENT
  alert_failure 1 || true
  exit 1
fi
export DEPENDABOT_WORKER_STARTED="$receipt_dir/started"
export DEPENDABOT_FAILURE_REPORTED="$receipt_dir/reported"
export DEPENDABOT_FALLBACK_ALERT_SENT="$receipt_dir/emergency"
trap 'rm -f "$receipt_dir/started" "$receipt_dir/reported" "$receipt_dir/emergency"; rmdir "$receipt_dir" 2>/dev/null || true' EXIT
if [ ! -x "$RUNTIME/python/bin/python" ] || [ ! -x "$RUNTIME/node/node_modules/.bin/gh-axi" ]; then
  echo "Dependabot runtime missing; run $0 --prepare-runtime through CFS first." >&2
  status=1
elif "$RUNTIME/python/bin/python" "$ROOT/scripts/dependabot_automerge.py" "$@"; then
  status=0
else
  status=$?
fi
if [ "$status" -ne 0 ] && ! failure_reported; then alert_failure "$status" || true; fi
exit "$status"
