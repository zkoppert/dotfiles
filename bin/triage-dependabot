#!/bin/bash
# Wrapper for launchd and ad-hoc runs. Resolves the dotfiles checkout,
# verifies the pinned notification-worker runtime, then execs
# triage_dependabot.py.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  linked_path="$(readlink "$source_path")"
  if [[ "$linked_path" = /* ]]; then
    source_path="$linked_path"
  else
    source_path="$source_dir/$linked_path"
  fi
done
bin_dir="$(cd -P "$(dirname "$source_path")" && pwd)"

exec "$bin_dir/run-notification-worker" \
  triage-dependabot \
  .copilot/skills/triage-dependabot/triage_dependabot.py \
  "$@"
