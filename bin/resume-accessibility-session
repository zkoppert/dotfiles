#!/bin/bash
set -euo pipefail

CONFIG_FILE="${ACCESSIBILITY_PICKER_CONFIG:-$HOME/.config/accessibility-issue-picker.env}"
if [ ! -f "$CONFIG_FILE" ]; then
  printf 'resume-accessibility-session: missing config file: %s\n' "$CONFIG_FILE" >&2
  exit 1
fi
export ACCESSIBILITY_PICKER_CONFIG="$CONFIG_FILE"

if ! /usr/bin/env python3 -c 'import os, sys; sys.exit(0 if os.stat(sys.argv[1]).st_mode & 0o077 == 0 else 1)' "$CONFIG_FILE"; then
  printf 'resume-accessibility-session: config file must have mode 0600: %s\n' "$CONFIG_FILE" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
set +e
. "$CONFIG_FILE" >/dev/null 2>&1
config_status=$?
set -e
set +a
if [ "$config_status" -ne 0 ]; then
  printf 'resume-accessibility-session: failed to load config file: %s\n' "$CONFIG_FILE" >&2
  exit 1
fi

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

ACCESSIBILITY_PICKER_CONFIG="$CONFIG_FILE" \
  "$SCRIPT_DIR/accessibility-issue-picker" --validate-config >/dev/null

exec /usr/bin/env python3 \
  "$SCRIPT_DIR/../scripts/resume_accessibility_session.py" \
  "$@"
