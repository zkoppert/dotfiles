#!/bin/bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

CONFIG_FILE="${ACCESSIBILITY_PICKER_CONFIG:-$HOME/.config/accessibility-issue-picker.env}"
case "$CONFIG_FILE" in
  /*) ;;
  *) CONFIG_FILE="$PWD/$CONFIG_FILE" ;;
esac
if [ ! -f "$CONFIG_FILE" ]; then
  printf 'accessibility-issue-picker: missing config file: %s\n' "$CONFIG_FILE" >&2
  exit 1
fi
export ACCESSIBILITY_PICKER_CONFIG="$CONFIG_FILE"

if ! /usr/bin/env python3 -c 'import os, sys; sys.exit(0 if os.stat(sys.argv[1]).st_mode & 0o077 == 0 else 1)' "$CONFIG_FILE"; then
  printf 'accessibility-issue-picker: config file must have mode 0600: %s\n' "$CONFIG_FILE" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
config_failed=0
trap 'config_failed=1' ERR
set +e
{
  . "$CONFIG_FILE"
  config_status=$?
  set +x
  set +v
} >/dev/null 2>&1
trap - ERR
set -e
set +a
if [ "$config_failed" -ne 0 ] || [ "$config_status" -ne 0 ]; then
  printf 'accessibility-issue-picker: failed to load config file: %s\n' "$CONFIG_FILE" >&2
  exit 1
fi
export GH_TOKEN="${ACCESSIBILITY_GITHUB_TOKEN:-}"
unset GITHUB_TOKEN

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

exec /usr/bin/env python3 \
  "$SCRIPT_DIR/../scripts/accessibility_issue_picker.py" \
  "$@"
