#!/usr/bin/env python3
"""Block oversized personal pull requests in selected repositories."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from urllib.parse import quote, urlparse
from pathlib import Path
from typing import Optional, Tuple

MAX_ADDITIONS = 800
TARGET_REPOSITORIES = {"github/github", "github/github-ui"}
OVERRIDE_VARIABLE = "ZACK_CONFIRMED_LARGE_PR"
ZERO_SHA = "0" * 40


class GuardError(RuntimeError):
    """Report a size check that cannot complete safely."""


def run(
    command: list[str],
    *,
    cwd: Path,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    """Run a command without hook-specific Git environment leaking into it."""
    environment = dict(os.environ)
    for name in ("GIT_COMMON_DIR", "GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE"):
        environment.pop(name, None)
    return subprocess.run(
        command,
        cwd=cwd,
        env=environment,
        capture_output=True,
        text=True,
        check=check,
    )


def run_bytes(
    command: list[str],
    *,
    cwd: Path,
) -> subprocess.CompletedProcess[bytes]:
    """Run a command and preserve binary stdout."""
    environment = dict(os.environ)
    for name in ("GIT_COMMON_DIR", "GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE"):
        environment.pop(name, None)
    return subprocess.run(
        command,
        cwd=cwd,
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def git(cwd: Path, *arguments: str) -> str:
    """Run Git and return trimmed stdout."""
    try:
        return run(["git", *arguments], cwd=cwd).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as error:
        detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) else str(error)
        raise GuardError(f"git {' '.join(arguments)} failed: {detail}") from error


def gh(cwd: Path, executable: str, *arguments: str) -> str:
    """Run GitHub CLI and return trimmed stdout."""
    try:
        return run([executable, *arguments], cwd=cwd).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as error:
        detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) else str(error)
        raise GuardError(f"gh {' '.join(arguments)} failed: {detail}") from error


def repository_from_url(url: str) -> Optional[str]:
    """Return an owner/repository pair for a GitHub remote URL."""
    scp_match = re.fullmatch(
        r"git@github\.com:([^/]+/[^/]+)",
        url,
        re.IGNORECASE,
    )
    if scp_match:
        return scp_match.group(1).removesuffix(".git").lower()
    parsed = urlparse(url)
    if parsed.hostname not in ("github.com", "ssh.github.com"):
        return None
    path = parsed.path.strip("/").removesuffix(".git")
    return path.lower() if path.count("/") == 1 else None


def repository_root() -> Path:
    """Return the current worktree root."""
    try:
        return Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
    except GuardError as error:
        raise GuardError("the current directory is not a Git worktree") from error


def remote_for_repository(root: Path, repository: str) -> str:
    """Find a configured remote that points at the target repository."""
    remotes = git(root, "remote").splitlines()
    for remote in remotes:
        url = git(root, "config", "--get", f"remote.{remote}.url")
        if repository_from_url(url) == repository:
            return remote
    raise GuardError(f"no configured remote points at {repository}")


def branch_merge_base(root: Path, branch: str) -> Optional[str]:
    """Return the branch-specific GitHub merge base when configured."""
    result = run(
        ["git", "config", "--get", f"branch.{branch}.gh-merge-base"],
        cwd=root,
        check=False,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def stack_parent_branch(
    root: Path, repository: str, branch: str
) -> Optional[str]:
    """Return the live parent branch recorded by the gh-stack extension."""
    git_dir = Path(git(root, "rev-parse", "--git-dir"))
    if not git_dir.is_absolute():
        git_dir = root / git_dir
    metadata_path = git_dir / "gh-stack"
    if not metadata_path.is_file():
        common_dir = Path(git(root, "rev-parse", "--git-common-dir"))
        if not common_dir.is_absolute():
            common_dir = root / common_dir
        metadata_path = common_dir / "gh-stack"
    try:
        payload = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    if (
        not isinstance(payload, dict)
        or payload.get("schemaVersion") != 1
        or (
            isinstance(payload.get("repository"), str)
            and payload["repository"]
            and payload["repository"].split(":", 1)[-1].lower() != repository
        )
    ):
        return None
    stacks = payload.get("stacks")
    if not isinstance(stacks, list):
        return None
    for stack in stacks:
        if not isinstance(stack, dict):
            continue
        trunk = stack.get("trunk")
        if not isinstance(trunk, dict) or not isinstance(trunk.get("branch"), str):
            continue
        branches = stack.get("branches")
        if not isinstance(branches, list):
            continue
        parent = trunk["branch"]
        for entry in branches:
            if (
                isinstance(entry, dict)
                and entry.get("branch") == branch
            ):
                return parent
            if isinstance(entry, dict) and isinstance(entry.get("branch"), str):
                parent = entry["branch"]
    return None


def open_pr_base(
    root: Path,
    executable: str,
    repository: str,
    branch: str,
    head_owner: str,
) -> Optional[str]:
    """Return the base branch for an open PR, if one exists."""
    head = quote(f"{head_owner}:{branch}", safe="")
    try:
        output = gh(
            root,
            executable,
            "api",
            f"repos/{repository}/pulls?state=open&head={head}&per_page=1",
            "--jq",
            ".[0].base.ref // \"\"",
        )
    except GuardError:
        return None
    return output or None


def default_branch(root: Path, executable: str, repository: str) -> str:
    """Return the repository's default branch."""
    branch = gh(
        root,
        executable,
        "repo",
        "view",
        repository,
        "--json",
        "defaultBranchRef",
        "--jq",
        ".defaultBranchRef.name",
    )
    if not branch:
        raise GuardError(f"cannot resolve the default branch for {repository}")
    return branch


def resolve_base(
    root: Path,
    *,
    executable: str,
    repository: str,
    branch: str,
    head_owner: str,
    head_remote: str,
    pushed_branches: set[str],
    explicit_base: Optional[str],
    check_open_pr: bool,
) -> Tuple[str, str]:
    """Resolve the base branch using GitHub CLI precedence."""
    if explicit_base:
        return explicit_base, "remote"
    if check_open_pr:
        pr_base = open_pr_base(root, executable, repository, branch, head_owner)
        if pr_base:
            return pr_base, "remote"
        stack_parent = stack_parent_branch(root, repository, branch)
        if stack_parent:
            local_parent = run(
                ["git", "rev-parse", "--verify", f"{stack_parent}^{{commit}}"],
                cwd=root,
                check=False,
            )
            if local_parent.returncode == 0:
                if stack_parent in pushed_branches:
                    return stack_parent, "local"
                fetched_parent = run(
                    [
                        "git",
                        "fetch",
                        "--quiet",
                        "--no-tags",
                        head_remote,
                        f"refs/heads/{stack_parent}",
                    ],
                    cwd=root,
                    check=False,
                )
                if fetched_parent.returncode == 0 and git(
                    root, "rev-parse", "--verify", "FETCH_HEAD^{commit}"
                ) == local_parent.stdout.strip():
                    return stack_parent, "local"
    configured_base = branch_merge_base(root, branch)
    if configured_base and configured_base != branch:
        return configured_base, "remote"
    return default_branch(root, executable, repository), "remote"


def fetch_base(root: Path, remote: str, base: str) -> str:
    """Fetch the current base branch and return its commit."""
    git(root, "fetch", "--quiet", "--no-tags", remote, f"refs/heads/{base}")
    return git(root, "rev-parse", "--verify", "FETCH_HEAD^{commit}")


def resolve_source(root: Path, remote: str, source: str) -> str:
    """Resolve a local or remote-tracking source commit."""
    candidates = [source]
    if not source.startswith("refs/"):
        candidates.append(f"refs/remotes/{remote}/{source}")
    for candidate in candidates:
        result = run(
            ["git", "rev-parse", "--verify", f"{candidate}^{{commit}}"],
            cwd=root,
            check=False,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    raise GuardError(f"cannot resolve the source commit {source}")


def ensure_merge_base(
    root: Path,
    *,
    remote: str,
    base: str,
    source_branch: str,
    base_commit: str,
    source_commit: str,
) -> str:
    """Deepen a shallow clone when necessary to find the PR merge base."""
    result = run(
        ["git", "merge-base", base_commit, source_commit],
        cwd=root,
        check=False,
    )
    if result.returncode == 0:
        return result.stdout.strip()
    if git(root, "rev-parse", "--is-shallow-repository") != "true":
        raise GuardError(f"no merge base exists between {base} and the source commit")

    for depth in (1000, 10000):
        refspecs = [
            f"refs/heads/{base}:refs/remotes/{remote}/{base}",
            f"refs/heads/{source_branch}:refs/remotes/{remote}/{source_branch}",
        ]
        fetch_result = run(
            [
                "git",
                "fetch",
                "--quiet",
                "--no-tags",
                f"--deepen={depth}",
                remote,
                *refspecs,
            ],
            cwd=root,
            check=False,
        )
        if fetch_result.returncode != 0:
            git(
                root,
                "fetch",
                "--quiet",
                "--no-tags",
                f"--deepen={depth}",
                remote,
                refspecs[0],
            )
        base_commit = git(
            root,
            "rev-parse",
            "--verify",
            f"refs/remotes/{remote}/{base}^{{commit}}",
        )
        result = run(
            ["git", "merge-base", base_commit, source_commit],
            cwd=root,
            check=False,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    raise GuardError(
        f"cannot find a merge base after deepening the shallow clone for {base}"
    )


def count_additions(root: Path, merge_base: str, source_commit: str) -> int:
    """Count text additions in the pull request diff."""
    result = run_bytes(
        [
            "git",
            "diff",
            "--numstat",
            "--find-renames",
            "-z",
            merge_base,
            source_commit,
        ],
        cwd=root,
    )
    if result.returncode != 0:
        raise GuardError(result.stderr.decode("utf-8", "replace").strip())
    records = result.stdout.split(b"\0")
    additions = 0
    attributed_text_paths: set[str] = set()
    index = 0
    while index < len(records) and records[index]:
        fields = records[index].split(b"\t", 2)
        if len(fields) != 3:
            raise GuardError("cannot parse NUL-delimited addition counts")
        added = fields[0].decode()
        path_bytes = fields[2]
        index += 1
        if path_bytes:
            old_path = new_path = path_bytes.decode("utf-8", "surrogateescape")
        else:
            if index + 1 >= len(records):
                raise GuardError("cannot parse renamed addition count")
            old_path = records[index].decode("utf-8", "surrogateescape")
            index += 1
            new_path = records[index].decode("utf-8", "surrogateescape")
            index += 1
        if added == "-":
            new_blob = run_bytes(
                ["git", "show", f"{source_commit}:{new_path}"],
                cwd=root,
            )
            if new_blob.returncode != 0 or b"\x00" in new_blob.stdout:
                continue
            attributed_text_paths.update((old_path, new_path))
        else:
            additions += int(added)
    if attributed_text_paths:
        text_diff = run_bytes(
            [
                "git",
                "diff",
                "--text",
                "--find-renames",
                "--unified=0",
                merge_base,
                source_commit,
                "--",
                *sorted(attributed_text_paths),
            ],
            cwd=root,
        )
        if text_diff.returncode != 0:
            raise GuardError(text_diff.stderr.decode("utf-8", "replace").strip())
        in_hunk = False
        for line in text_diff.stdout.splitlines():
            if line.startswith(b"diff --git "):
                in_hunk = False
            elif line.startswith(b"@@"):
                in_hunk = True
            elif in_hunk and line.startswith(b"+"):
                additions += 1
    return additions


def check_size(args: argparse.Namespace) -> int:
    """Check one prospective pull request diff."""
    args.repository = args.repository.lower()
    if args.repository not in TARGET_REPOSITORIES:
        return 0
    if args.source == ZERO_SHA:
        return 0

    root = repository_root()
    remote = args.remote or remote_for_repository(root, args.repository)
    head_remote = args.head_remote or remote
    base, base_location = resolve_base(
        root,
        executable=args.gh,
        repository=args.repository,
        branch=args.branch,
        head_owner=args.head_owner,
        head_remote=head_remote,
        pushed_branches=set(args.pushed_branch),
        explicit_base=args.base,
        check_open_pr=args.check_open_pr,
    )
    base_commit = (
        resolve_source(root, remote, base)
        if base_location == "local"
        else fetch_base(root, remote, base)
    )
    source_commit = resolve_source(root, remote, args.source)
    merge_base = ensure_merge_base(
        root,
        remote=remote,
        base=base,
        source_branch=args.branch,
        base_commit=base_commit,
        source_commit=source_commit,
    )
    additions = count_additions(root, merge_base, source_commit)

    if additions <= MAX_ADDITIONS:
        print(
            f"pr-size-guard: {args.repository} {args.branch} has "
            f"{additions}/{MAX_ADDITIONS} added lines."
        )
        return 0

    if os.environ.get(OVERRIDE_VARIABLE) == "1":
        print(
            f"pr-size-guard: override accepted for {args.repository} "
            f"with {additions} added lines."
        )
        return 0

    print(
        f"pr-size-guard: blocked {args.context} for {args.repository}.",
        file=sys.stderr,
    )
    print(
        f"The prospective PR has {additions} added lines. The personal limit is "
        f"{MAX_ADDITIONS}.",
        file=sys.stderr,
    )
    print(
        "Split the work into a stacked PR before continuing. Use "
        "`npx -y gh-axi stack init` or `npx -y gh-axi stack add`, then "
        "`npx -y gh-axi stack submit --open`.",
        file=sys.stderr,
    )
    print(
        f"Only after Zack explicitly approves an exception, retry with "
        f"{OVERRIDE_VARIABLE}=1 in the same command.",
        file=sys.stderr,
    )
    return 1


def parse_args(arguments: list[str]) -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo", dest="repository", required=True)
    parser.add_argument("--branch", required=True)
    parser.add_argument("--source", required=True)
    parser.add_argument("--base")
    parser.add_argument("--remote")
    parser.add_argument("--gh", default="gh")
    parser.add_argument("--head-owner", required=True)
    parser.add_argument("--head-remote")
    parser.add_argument("--pushed-branch", action="append", default=[])
    parser.add_argument("--context", choices=("draft creation", "push"), required=True)
    parser.add_argument("--check-open-pr", action="store_true")
    return parser.parse_args(arguments)


def main(arguments: Optional[list[str]] = None) -> int:
    """Run the guard."""
    args = parse_args(arguments or sys.argv[1:])
    try:
        return check_size(args)
    except (GuardError, ValueError) as error:
        print(
            f"pr-size-guard: blocked {args.context} for {args.repository}: {error}",
            file=sys.stderr,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
