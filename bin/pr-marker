#!/usr/bin/env python3
"""Read/write the per-branch PR-readiness marker files that gh-guard gates on.

Zack's change workflow requires five review, demo, and check-run artifacts to
exist before `gh pr create` is allowed to open a PR (enforced by the gh-guard
PATH shim). The artifacts for a branch live together in a per-branch directory
`<git-dir>/copilot-pr-review/<encoded-branch>/`, one file per kind.

This helper is the single source of truth for the marker path encoding so that
agents and humans never have to reproduce the fiddly git-dir resolution and
branch-name percent-encoding by hand (getting it wrong means writing the marker
to the wrong path and then being blocked by the gate for no visible reason).

Marker kinds (filename inside `<git-dir>/copilot-pr-review/<encoded-branch>/`,
minimum size in bytes, whether HEAD-pinned, and whether a multi-model review):

  code-review  code-review.md   200   multi-model review of the code diff
                                      (pinned, requires >=3 models and a final
                                      clean convergence round from 1 through 3)
  plan         plan.md          120   multi-model review of the plan
                                      (requires >=3 models)
  demo         demo.md          120   demo video + before/after images
                                      (or an explicit "N/A" justification)
  pr-review    pr-review.md     120   multi-model review of the PR body
                                      (requires >=3 models)
  tests        tests.md         120   machine-produced record of a full
                                      CI-equivalent check run passing green
                                      (pinned; written by `run-tests`)

The code-review and tests markers are HEAD-pinned: `write`/`run-tests` records
the current HEAD commit on the first line (`<!-- reviewed-commit: <sha> -->`),
and the marker is reported stale once HEAD moves past that commit, so an
artifact that never saw the shipping diff cannot satisfy the gate. Re-run and
rewrite the marker after any later commit.

The three review markers (code-review, plan, pr-review) also require a
multi-model review: `write` refuses them unless `--models` names >=3 distinct
models, and records them in a `<!-- reviewed-by-models: a, b, c -->` header, so
a lightweight single-pass self-review cannot satisfy a gate meant to require a
multi-model review. `status`/`check` and gh-guard reject a review marker that
declares fewer than 3 distinct models. The demo and tests markers are exempt.
The code-review marker also requires `--convergence-rounds N`, where N is the
final panel round that found no new verified findings. `status`/`check` and
gh-guard accept only the workflow's range of 1 through 3.

The tests marker is machine-produced: `run-tests` requires a clean repository,
runs the test-quality evidence preflight and the given check commands, verifies
the repository stayed clean, and writes the marker only if every command exits
0. This records the committed tree that passed tests, lint, type-check, and
build rather than a self-reported note.

The branch directory name is percent-encoded. The encoding MUST stay identical
to gh-guard's inline computation:
  printf '%s' "$branch" | sed -e 's/%/%25/g' -e 's|/|%2F|g'
i.e. replace '%' with '%25' first, then '/' with '%2F'. `bin/test_pr_marker.py`
asserts this helper agrees with that exact sed pipeline, and that gh-guard's
byte floors, filenames, pin flags, and model requirement match KINDS. Giving
each branch its own directory (rather than suffixing the encoded branch onto
every filename) avoids collisions between, e.g., branch `x`'s plan marker and
branch `x.plan`'s code-review marker.

Usage:
  pr-marker path <kind>            print the marker file path for the current branch
  pr-marker artifacts-dir <kind>   print the sibling artifacts directory path
  pr-marker write <kind> [FILE] [--models a,b,c] [--convergence-rounds N]
                                   write marker content from FILE (or stdin if
                                   '-'/omitted); review kinds require >=3 --models,
                                   and code-review requires a clean round number
  pr-marker run-tests --cmd '<command>' [--cmd '<command>' ...]
                      [--base-ref REF] [--no-test-change-reason REASON]
                      [--narrow reason]
                                   run the evidence preflight and each check command;
                                   write the HEAD-pinned tests marker only if every
                                   command exits 0 and the repository stays clean
  pr-marker status                 show all five markers and whether each passes
  pr-marker check                  exit 0 only if every marker passes (fresh + over
                                   floor)
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path


@dataclass(frozen=True)
class Kind:
    """A marker kind and the validation rules enforced for it."""

    name: str
    filename: str
    min_bytes: int
    summary: str
    pinned: bool = False
    requires_models: bool = False
    requires_result: bool = False
    requires_convergence: bool = False


KINDS: dict[str, Kind] = {
    "code-review": Kind(
        "code-review",
        "code-review.md",
        200,
        "multi-model review of the code diff",
        pinned=True,
        requires_models=True,
        requires_convergence=True,
    ),
    "plan": Kind(
        "plan",
        "plan.md",
        120,
        "multi-model review of the plan",
        requires_models=True,
    ),
    "demo": Kind(
        "demo",
        "demo.md",
        120,
        "demo video + before/after images (or N/A justification)",
    ),
    "pr-review": Kind(
        "pr-review",
        "pr-review.md",
        120,
        "multi-model review of the PR description",
        requires_models=True,
    ),
    "tests": Kind(
        "tests",
        "tests.md",
        120,
        "machine-produced record of a full CI-equivalent check run "
        "(tests, lint, type-check, build) passing green in a Codespace",
        pinned=True,
        requires_result=True,
    ),
}

MARKER_SUBDIR = "copilot-pr-review"

# A pinned marker records the commit it reviewed on its first line so the gate
# can reject it once HEAD moves past that commit (a review that never saw the
# shipping diff). Keep this literal in sync with gh-guard's sed extraction.
REVIEWED_COMMIT_PREFIX = "<!-- reviewed-commit: "
REVIEWED_COMMIT_SUFFIX = " -->"

# A review marker (plan, code-review, pr-review) must declare which models
# reviewed it, so a lightweight single-pass self-review cannot satisfy a gate
# that is meant to require a multi-model review. The models are recorded in a
# header line (not position-pinned, so it coexists with the reviewed-commit
# line-1 header on the code-review marker); both pr-marker and gh-guard parse
# this same literal, splitting the inner list on commas and counting distinct
# case-insensitive names. Keep this format in sync with gh-guard's extraction.
REVIEWED_MODELS_PREFIX = "<!-- reviewed-by-models: "
REVIEWED_MODELS_SUFFIX = " -->"
MIN_MODELS = 3

# A code-review marker must record that its final review round was clean and
# how many rounds were needed. Both pr-marker and gh-guard enforce the exact
# header and the workflow's 3-round cap.
REVIEW_CONVERGENCE_PREFIX = "<!-- review-convergence: clean; rounds: "
REVIEW_CONVERGENCE_SUFFIX = " -->"
MIN_REVIEW_ROUNDS = 1
MAX_REVIEW_ROUNDS = 3

# A machine-produced marker (tests) must carry this exact header, written only
# by `run-tests` after every check command exits 0. `status`/`check` and gh-guard
# require it, so a hand-written note or bare `touch` cannot satisfy the gate.
# Keep this literal in sync with gh-guard's grep.
TESTS_RESULT_HEADER = "<!-- tests-result: passed -->"


def _git(*args: str) -> str:
    """Run a git command and return stripped stdout, or raise on failure."""
    result = subprocess.run(
        ["git", *args],
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout.strip()


def encode_branch(branch: str) -> str:
    """Percent-encode a branch name for use as a marker filename.

    Order matters: encode '%' before '/' so a literal '%2F' in a branch name is
    not confused with an encoded slash. This mirrors gh-guard's sed pipeline.
    """
    return branch.replace("%", "%25").replace("/", "%2F")


def marker_dir() -> Path:
    """Return the base `<git-dir>/copilot-pr-review` directory for this checkout.

    Uses `git rev-parse --absolute-git-dir`, which resolves to `<repo>/.git`
    for plain checkouts and to `<main>/.git/worktrees/<name>/` for worktrees.
    """
    git_dir = _git("rev-parse", "--absolute-git-dir")
    return Path(git_dir) / MARKER_SUBDIR


def current_branch() -> str:
    """Return the current branch name, or raise if on a detached HEAD.

    Uses `git symbolic-ref --short HEAD` rather than `rev-parse --abbrev-ref`
    so it also works before the first commit (an unborn branch), while still
    failing on a genuinely detached HEAD. gh-guard resolves the branch with the
    identical command, so both agree on the marker filename (and both fail the
    same way on a detached HEAD).
    """
    try:
        branch = _git("symbolic-ref", "--short", "HEAD")
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(
            "cannot resolve a branch name (detached HEAD?); "
            "check out a branch before writing markers"
        ) from exc
    if not branch:
        raise RuntimeError(
            "cannot resolve a branch name (detached HEAD?); "
            "check out a branch before writing markers"
        )
    return branch


def current_head() -> str | None:
    """Return the current HEAD commit SHA, or None on an unborn/detached repo."""
    try:
        return _git("rev-parse", "HEAD")
    except subprocess.CalledProcessError:
        return None


def dirty_worktree_entries() -> list[str]:
    """Return staged, unstaged, and untracked non-ignored status entries."""
    result = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z"],
        capture_output=True,
        check=True,
    )
    return [
        entry.decode("utf-8", errors="replace")
        for entry in result.stdout.split(b"\0")
        if entry
    ]


def test_quality_checker_path() -> Path:
    """Return the checker path beside this dotfiles checkout."""
    return (
        Path(__file__).resolve().parent.parent
        / ".copilot"
        / "skills"
        / "test-quality"
        / "check.py"
    )


def read_reviewed_commit(path: Path) -> str | None:
    """Return the reviewed-commit SHA recorded on a marker's first line, if any."""
    try:
        first_line = path.read_text(encoding="utf-8").splitlines()[0]
    except (OSError, IndexError):
        return None
    if first_line.startswith(REVIEWED_COMMIT_PREFIX) and first_line.endswith(
        REVIEWED_COMMIT_SUFFIX
    ):
        return first_line.removeprefix(REVIEWED_COMMIT_PREFIX).removesuffix(
            REVIEWED_COMMIT_SUFFIX
        )
    return None


def parse_models(raw: str | None) -> list[str]:
    """Split a comma-separated model list into distinct, case-insensitive names.

    Whitespace around each name is trimmed and empty entries dropped. Order is
    preserved and duplicates (ignoring case) are collapsed, so
    "Opus, opus , sonnet" yields ["Opus", "sonnet"]. Used both to validate the
    `--models` argument on write and to count declared models on read; gh-guard
    counts distinct names the same way (tr/sed/sort -u).
    """
    if not raw:
        return []
    distinct: list[str] = []
    seen: set[str] = set()
    for part in raw.split(","):
        name = part.strip()
        if not name:
            continue
        key = name.lower()
        if key in seen:
            continue
        seen.add(key)
        distinct.append(name)
    return distinct


def read_reviewed_models(path: Path) -> list[str]:
    """Return the distinct models declared in a marker's reviewed-by-models header.

    Scans every line (the header is not position-pinned, so it can sit on line 2
    of a pinned code-review marker) and returns the models from the first header
    line found, or [] if there is none.
    """
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    for line in lines:
        if line.startswith(REVIEWED_MODELS_PREFIX) and line.endswith(
            REVIEWED_MODELS_SUFFIX
        ):
            inner = line.removeprefix(REVIEWED_MODELS_PREFIX).removesuffix(
                REVIEWED_MODELS_SUFFIX
            )
            return parse_models(inner)
    return []


def read_convergence_rounds(path: Path) -> int | None:
    """Return the validated clean convergence round count, if declared."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    convergence_lines = [
        line for line in lines if line.startswith("<!-- review-convergence:")
    ]
    if len(convergence_lines) != 1:
        return None
    canonical_headers = {
        f"{REVIEW_CONVERGENCE_PREFIX}{rounds}{REVIEW_CONVERGENCE_SUFFIX}": rounds
        for rounds in range(MIN_REVIEW_ROUNDS, MAX_REVIEW_ROUNDS + 1)
    }
    return canonical_headers.get(convergence_lines[0])


def has_result_header(path: Path) -> bool:
    """Return True if the marker carries the machine-produced tests-result header.

    The header is written only by `run-tests` after every check command exits 0,
    so requiring it prevents a hand-written or bare-touch file from satisfying the
    tests gate. gh-guard greps for the identical literal.
    """
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    return TESTS_RESULT_HEADER in lines


def branch_dir(branch: str | None = None) -> Path:
    """Return the per-branch marker directory `<...>/copilot-pr-review/<branch>`.

    The branch component is percent-encoded so a name containing `/` stays a
    single flat directory rather than a nested path.
    """
    if branch is None:
        branch = current_branch()
    return marker_dir() / encode_branch(branch)


def marker_path(kind: Kind, branch: str | None = None) -> Path:
    """Return the absolute marker file path for a kind on the given branch."""
    return branch_dir(branch) / kind.filename


def artifacts_dir(kind: Kind, branch: str | None = None) -> Path:
    """Return the sibling artifacts directory for a kind (e.g. demo.artifacts)."""
    return branch_dir(branch) / f"{kind.name}.artifacts"


def _resolve_kind(name: str) -> Kind:
    """Return the Kind for a name, exiting with a helpful error if unknown."""
    try:
        return KINDS[name]
    except KeyError:
        valid = ", ".join(KINDS)
        raise SystemExit(f"pr-marker: unknown kind '{name}' (valid: {valid})") from None


def cmd_path(args: argparse.Namespace) -> int:
    """Print the marker file path for a kind on the current branch."""
    print(marker_path(_resolve_kind(args.kind)))
    return 0


def cmd_artifacts_dir(args: argparse.Namespace) -> int:
    """Print the sibling artifacts directory for a kind."""
    print(artifacts_dir(_resolve_kind(args.kind)))
    return 0


def strip_generated_headers(content: str) -> str:
    """Remove headers previously generated by pr-marker before rewriting."""
    kept: list[str] = []
    for line in content.splitlines(keepends=True):
        normalized = line.rstrip("\r\n")
        is_generated = (
            (
                normalized.startswith(REVIEWED_COMMIT_PREFIX)
                and normalized.endswith(REVIEWED_COMMIT_SUFFIX)
            )
            or (
                normalized.startswith(REVIEWED_MODELS_PREFIX)
                and normalized.endswith(REVIEWED_MODELS_SUFFIX)
            )
            or normalized.startswith("<!-- review-convergence:")
            or normalized == TESTS_RESULT_HEADER
        )
        if not is_generated:
            kept.append(line)
    return "".join(kept)


def cmd_write(args: argparse.Namespace) -> int:
    """Write marker content from a file or stdin, refusing content below the floor."""
    kind = _resolve_kind(args.kind)
    if kind.requires_result:
        print(
            f"pr-marker: the {kind.name} marker is machine-produced; write it with "
            f"`pr-marker run-tests --cmd '<command>'` (it runs the checks and only "
            f"writes when every command exits 0), not `write`.",
            file=sys.stderr,
        )
        return 1
    if args.file in (None, "-"):
        content = sys.stdin.read()
    else:
        content = Path(args.file).read_text(encoding="utf-8")
    content = strip_generated_headers(content)

    # The byte floor applies to the review content the caller provides, not to
    # any reviewed-commit / reviewed-by-models header prepended below.
    size = len(content.encode("utf-8"))
    if size < kind.min_bytes:
        print(
            f"pr-marker: refusing to write {kind.name} marker: "
            f"content is {size} bytes, but the gate requires >= {kind.min_bytes}. "
            f"Write the real {kind.summary}.",
            file=sys.stderr,
        )
        return 1

    # A review marker must name the models that reviewed it (>= MIN_MODELS
    # distinct), so a single-pass self-review cannot satisfy a multi-model gate.
    models: list[str] = []
    if kind.requires_models:
        models = parse_models(args.models)
        if len(models) < MIN_MODELS:
            print(
                f"pr-marker: refusing to write {kind.name} marker: "
                f"it records a {kind.summary}, which requires >= {MIN_MODELS} "
                f"distinct models, but --models gave {len(models)} "
                f"({', '.join(models) or 'none'}). Re-run the review across "
                f"different models and pass, e.g., "
                f"--models opus-4.8,sonnet-4.6,gpt-5.5.",
                file=sys.stderr,
            )
            return 1
    convergence_rounds: int | None = None
    if kind.requires_convergence:
        convergence_rounds = args.convergence_rounds
        if convergence_rounds is None:
            print(
                f"pr-marker: refusing to write {kind.name} marker: "
                "the code-review gate requires a final clean convergence round. "
                "Pass --convergence-rounds 1, 2, or 3.",
                file=sys.stderr,
            )
            return 1

    headers = ""
    pinned_sha: str | None = None
    if kind.pinned:
        head = current_head()
        if head is None:
            print(
                f"pr-marker: cannot pin the {kind.name} marker: no HEAD commit "
                "to review (unborn or detached). Commit the change first.",
                file=sys.stderr,
            )
            return 1
        pinned_sha = head
        headers += f"{REVIEWED_COMMIT_PREFIX}{head}{REVIEWED_COMMIT_SUFFIX}\n"
    if models:
        joined = ", ".join(models)
        headers += f"{REVIEWED_MODELS_PREFIX}{joined}{REVIEWED_MODELS_SUFFIX}\n"
    if convergence_rounds is not None:
        headers += (
            f"{REVIEW_CONVERGENCE_PREFIX}{convergence_rounds}"
            f"{REVIEW_CONVERGENCE_SUFFIX}\n"
        )
    content = headers + content

    path = marker_path(kind)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    note = f" (pinned to {pinned_sha[:12]})" if pinned_sha else ""
    models_note = f" [models: {', '.join(models)}]" if models else ""
    convergence_note = (
        f" [clean convergence: round {convergence_rounds}]"
        if convergence_rounds is not None
        else ""
    )
    print(
        f"pr-marker: wrote {size} bytes to {path}{note}{models_note}"
        f"{convergence_note}"
    )
    return 0


def _invalidate_tests_marker(kind: Kind) -> str:
    """Remove a prior tests marker and return a note for the error message."""
    stale = marker_path(kind)
    if not stale.exists():
        return ""
    stale.unlink()
    return " (removed the previous tests marker)"


def _run_test_quality_preflight(args: argparse.Namespace) -> tuple[int, dict[str, object]]:
    """Run the test-evidence checker and return its exit code and JSON result."""
    checker = test_quality_checker_path()
    if not checker.is_file():
        print(
            f"pr-marker run-tests: WARNING: test-quality checker not found at {checker}; "
            "continuing for compatibility with an older dotfiles checkout.",
            file=sys.stderr,
        )
        return (
            0,
            {
                "status": "unavailable",
                "evidence": "unavailable",
                "base_ref": None,
                "base_commit": None,
                "source_files": [],
                "test_files": [],
                "warning_count": 1,
                "waiver": args.no_test_change_reason,
            },
        )

    command = [sys.executable, str(checker), "--json"]
    if args.base_ref:
        command += ["--base", args.base_ref]
    if args.no_test_change_reason:
        command += ["--no-test-change-reason", args.no_test_change_reason]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        print(
            "pr-marker run-tests: test-quality checker returned invalid JSON.",
            file=sys.stderr,
        )
        if result.stdout:
            print(result.stdout, file=sys.stderr)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        return (2, {})
    if not isinstance(payload, dict):
        print(
            "pr-marker run-tests: test-quality checker JSON must be an object.",
            file=sys.stderr,
        )
        return (2, {})

    status = payload.get("status", "unknown")
    evidence = payload.get("evidence", "unknown")
    warnings = int(payload.get("warning_count", 0))
    print(
        f"pr-marker run-tests: test-quality preflight {status} "
        f"(evidence: {evidence}, warnings: {warnings})",
        file=sys.stderr,
    )
    for finding in payload.get("findings", []):
        if not isinstance(finding, dict):
            continue
        severity = str(finding.get("severity", "warning")).upper()
        rule = finding.get("rule", "unknown")
        message = finding.get("message", "")
        paths = finding.get("paths") or []
        paths_note = f" [{', '.join(str(path) for path in paths)}]" if paths else ""
        print(
            f"pr-marker run-tests: {severity} [{rule}] {message}{paths_note}",
            file=sys.stderr,
        )
    if result.stderr:
        print(result.stderr, file=sys.stderr)
    if result.returncode == 0 and (
        status != "passed" or evidence == "unavailable"
    ):
        print(
            "pr-marker run-tests: the test-quality preflight did not analyze a "
            "branch diff; pass --base-ref <ref>.",
            file=sys.stderr,
        )
        return (1, payload)
    return (result.returncode, payload)


def cmd_run_tests(args: argparse.Namespace) -> int:
    """Run the check commands and write the `tests` marker only if all pass.

    Streams each command's output live (so a long full-suite run is watchable),
    records the exit codes as machine proof, and writes the HEAD-pinned marker
    only when every command exits 0. Any failure writes nothing and exits
    non-zero, so the gate stays blocked until a real green run exists.
    """
    kind = KINDS["tests"]
    head = current_head()
    if head is None:
        print(
            "pr-marker: cannot pin the tests marker: no HEAD commit "
            "(unborn or detached). Commit the change first.",
            file=sys.stderr,
        )
        return 1

    dirty_before = dirty_worktree_entries()
    if dirty_before:
        removed = _invalidate_tests_marker(kind)
        print(
            "pr-marker run-tests: refusing to certify HEAD while the repository has "
            f"staged, unstaged, or untracked files{removed}:",
            file=sys.stderr,
        )
        for entry in dirty_before:
            print(f"  {entry}", file=sys.stderr)
        print(
            "Commit or remove the changes, then run the full checks again.",
            file=sys.stderr,
        )
        return 1

    commands = [c.strip() for c in args.cmd]
    if any(not c for c in commands):
        print(
            "pr-marker run-tests: refusing to run: an empty --cmd was given; "
            "pass the real check commands.",
            file=sys.stderr,
        )
        return 1

    quality_code, quality = _run_test_quality_preflight(args)
    if quality_code != 0:
        removed = _invalidate_tests_marker(kind)
        print(
            "pr-marker run-tests: test-quality evidence preflight failed; "
            f"not running checks or writing the tests marker{removed}.",
            file=sys.stderr,
        )
        return 1

    codespace = args.codespace or os.environ.get("CODESPACE_NAME") or "unknown"
    results: list[tuple[str, int, float]] = []
    for cmd in commands:
        print(f"pr-marker run-tests: running: {cmd}", file=sys.stderr)
        start = time.monotonic()
        # shell=True runs the author-supplied check commands (make test, etc.)
        code = subprocess.run(cmd, shell=True).returncode
        duration = time.monotonic() - start
        results.append((cmd, code, duration))
        label = "passed" if code == 0 else f"FAILED (exit {code})"
        print(
            f"pr-marker run-tests: {label} in {duration:.1f}s: {cmd}",
            file=sys.stderr,
        )

    failed = [c for c, code, _ in results if code != 0]
    if failed:
        removed = _invalidate_tests_marker(kind)
        print(
            f"pr-marker run-tests: {len(failed)} of {len(results)} command(s) failed; "
            f"not writing the tests marker{removed}.",
            file=sys.stderr,
        )
        return 1

    dirty_after = dirty_worktree_entries()
    if dirty_after:
        removed = _invalidate_tests_marker(kind)
        print(
            "pr-marker run-tests: checks changed the repository, so the run cannot "
            f"certify HEAD{removed}:",
            file=sys.stderr,
        )
        for entry in dirty_after:
            print(f"  {entry}", file=sys.stderr)
        print(
            "Clean or commit the generated changes, then run the full checks again.",
            file=sys.stderr,
        )
        return 1

    ran_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    source_files = quality.get("source_files") or []
    test_files = quality.get("test_files") or []
    warning_count = int(quality.get("warning_count", 0))
    waiver = quality.get("waiver") or "none"
    lines = [
        f"{REVIEWED_COMMIT_PREFIX}{head}{REVIEWED_COMMIT_SUFFIX}",
        TESTS_RESULT_HEADER,
        "# tests: full CI-equivalent check run",
        "",
        f"RESULT: passed (all {len(results)} command(s) exited 0)",
        f"Codespace: {codespace}",
        f"Ran at: {ran_at}",
        f"Commit: {head}",
        "",
        "Test-quality evidence preflight:",
        f"- status: {quality.get('status', 'unavailable')}",
        f"- evidence: {quality.get('evidence', 'unavailable')}",
        f"- base ref: {quality.get('base_ref') or 'unavailable'}",
        f"- base commit: {quality.get('base_commit') or 'unavailable'}",
        f"- executable source files changed: {len(source_files)}",
        f"- test files changed: {len(test_files)}",
        f"- warnings: {warning_count}",
        f"- no-test-change reason: {waiver}",
        "",
        "Commands:",
    ]
    lines += [f"- exit {code} in {dur:.1f}s: {cmd}" for cmd, code, dur in results]
    lines += ["", f"Narrowing: {args.narrow or 'none (full suite)'}"]
    content = "\n".join(lines) + "\n"

    path = marker_path(kind)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    size = len(content.encode("utf-8"))
    print(
        f"pr-marker: wrote {size} bytes to {path} "
        f"(pinned to {head[:12]}) [tests: passed]"
    )
    return 0


def marker_status(kind: Kind, branch: str) -> tuple[bool, str, int, Path]:
    """Return (ok, detail, size_bytes, path).

    detail is one of: "ok", "missing", "too small", "stale" (pinned marker whose
    reviewed-commit no longer equals HEAD), "needs models" (fewer than MIN_MODELS
    declared), "needs convergence" (no valid final-clean-round metadata), or
    "no result" (a requires_result marker missing the machine header).
    """
    path = marker_path(kind, branch)
    if not path.is_file():
        return (False, "missing", 0, path)
    size = path.stat().st_size
    if size < kind.min_bytes:
        return (False, "too small", size, path)
    if kind.pinned:
        recorded = read_reviewed_commit(path)
        head = current_head()
        if not recorded or not head or recorded != head:
            return (False, "stale", size, path)
    if kind.requires_models and len(read_reviewed_models(path)) < MIN_MODELS:
        return (False, "needs models", size, path)
    if kind.requires_convergence and read_convergence_rounds(path) is None:
        return (False, "needs convergence", size, path)
    if kind.requires_result and not has_result_header(path):
        return (False, "no result", size, path)
    return (True, "ok", size, path)


def cmd_status(_args: argparse.Namespace) -> int:
    """Print each marker's status and whether the gate would pass."""
    branch = current_branch()
    print(f"branch: {branch}")
    print(f"marker dir: {branch_dir(branch)}")
    print()
    all_ok = True
    for kind in KINDS.values():
        ok, detail, size, path = marker_status(kind, branch)
        all_ok = all_ok and ok
        mark = "ok " if ok else detail.upper()
        pin = " pinned" if kind.pinned else ""
        print(
            f"  [{mark:>9}] {kind.name:<12} {size:>5}B (>= {kind.min_bytes}B)  "
            f"{path.name}{pin}"
        )
    print()
    if all_ok:
        print("all markers satisfied")
    else:
        print("gate would BLOCK: fill the missing/stale markers")
        print(
            "(a STALE pinned marker means HEAD moved since it was written; "
            "re-run it and rewrite so it re-pins to the current HEAD)"
        )
    return 0 if all_ok else 1


def cmd_check(_args: argparse.Namespace) -> int:
    """Exit non-zero (printing each gap) unless every marker passes its floor."""
    branch = current_branch()
    failures = []
    for kind in KINDS.values():
        ok, detail, _size, path = marker_status(kind, branch)
        if not ok:
            failures.append((detail, kind, path))
    if failures:
        for detail, kind, path in failures:
            print(
                f"pr-marker: {detail} {kind.name} marker at {path}",
                file=sys.stderr,
            )
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    """Build the argparse parser for the pr-marker subcommands."""
    parser = argparse.ArgumentParser(
        prog="pr-marker",
        description="Read/write the per-branch PR-readiness markers gh-guard gates on.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_path = sub.add_parser("path", help="print the marker file path for a kind")
    p_path.add_argument("kind", help="one of: " + ", ".join(KINDS))
    p_path.set_defaults(func=cmd_path)

    p_art = sub.add_parser(
        "artifacts-dir", help="print the sibling artifacts dir for a kind"
    )
    p_art.add_argument("kind", help="one of: " + ", ".join(KINDS))
    p_art.set_defaults(func=cmd_artifacts_dir)

    p_write = sub.add_parser("write", help="write marker content from a file or stdin")
    p_write.add_argument("kind", help="one of: " + ", ".join(KINDS))
    p_write.add_argument(
        "file", nargs="?", default="-", help="file to read (default: stdin)"
    )
    p_write.add_argument(
        "--models",
        default=None,
        help=(
            "comma-separated models that reviewed this marker; required for "
            f"review kinds (>= {MIN_MODELS} distinct), e.g. "
            "opus-4.8,sonnet-4.6,gpt-5.5"
        ),
    )
    p_write.add_argument(
        "--convergence-rounds",
        type=int,
        choices=range(MIN_REVIEW_ROUNDS, MAX_REVIEW_ROUNDS + 1),
        default=None,
        help=(
            "round number whose multi-model code review found no new verified "
            "findings; required for code-review"
        ),
    )
    p_write.set_defaults(func=cmd_write)

    p_status = sub.add_parser("status", help="show all markers and whether each passes")
    p_status.set_defaults(func=cmd_status)

    p_check = sub.add_parser("check", help="exit 0 only if every marker passes")
    p_check.set_defaults(func=cmd_check)

    p_run = sub.add_parser(
        "run-tests",
        help="run check commands and write the tests marker only if all pass",
    )
    p_run.add_argument(
        "--cmd",
        action="append",
        required=True,
        metavar="COMMAND",
        help=(
            "a check command to run (repeatable), e.g. "
            "--cmd 'make test' --cmd 'make lint'"
        ),
    )
    p_run.add_argument(
        "--codespace",
        default=None,
        help="Codespace name to record (defaults to $CODESPACE_NAME)",
    )
    p_run.add_argument(
        "--narrow",
        default=None,
        help=(
            "record an explicit infeasibility narrowing "
            "(genuine infeasibility only, never slowness)"
        ),
    )
    p_run.add_argument(
        "--base-ref",
        default=None,
        help=(
            "base branch/ref for the test-quality diff "
            "(defaults to environment/default-branch inference)"
        ),
    )
    p_run.add_argument(
        "--no-test-change-reason",
        default=None,
        help=(
            "specific reason executable source changed without a committed test "
            "change; recorded in the tests marker"
        ),
    )
    p_run.set_defaults(func=cmd_run_tests)

    return parser


def _reorder_write_argv(argv: list[str]) -> list[str]:
    """Move write options after the positionals so argparse binds FILE.

    argparse mis-handles a `nargs='?'` positional that follows an optional inside
    a subparser: `write pr-review --models a,b,c -` fails to bind the trailing
    `-` to `file`. Normalizing so the optional trails the positionals (the order
    argparse does handle) lets callers pass `--models` in the natural place,
    including the `--models a,b,c -` form the gh-guard help suggests.     Other commands pass through untouched.
    """
    if not argv or argv[0] != "write":
        return argv
    rest = argv[1:]
    option_tokens: list[str] = []
    others: list[str] = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg in ("--models", "--convergence-rounds"):
            option_tokens.append(arg)
            if i + 1 < len(rest):
                option_tokens.append(rest[i + 1])
                i += 2
                continue
        elif arg.startswith("--models=") or arg.startswith("--convergence-rounds="):
            option_tokens.append(arg)
        else:
            others.append(arg)
        i += 1
    return ["write", *others, *option_tokens]


def main(argv: list[str] | None = None) -> int:
    """Parse args and dispatch to the selected subcommand."""
    if argv is None:
        argv = sys.argv[1:]
    argv = _reorder_write_argv(argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except subprocess.CalledProcessError:
        print(
            "pr-marker: not inside a git checkout (git rev-parse failed)",
            file=sys.stderr,
        )
        return 2
    except (RuntimeError, OSError) as exc:
        print(f"pr-marker: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
