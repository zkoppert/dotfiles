#!/usr/bin/env python3
"""Read/write the per-branch PR-readiness marker files that gh-guard gates on.

Zack's change workflow requires five review, demo, and check-run artifacts to
exist before `gh pr create` is allowed to open a PR (enforced by the gh-guard
PATH shim). The artifacts for a branch live together in a per-branch directory
`<git-dir>/copilot-pr-review/<encoded-branch>/`, one file per kind.

This helper is the single source of truth for the marker path encoding so that
agents and humans never have to reproduce the fiddly git-dir resolution and
branch-name percent-encoding by hand (getting it wrong means writing the marker
to the wrong path and then being blocked by the gate for no visible reason).

Marker kinds (filename inside `<git-dir>/copilot-pr-review/<encoded-branch>/`,
minimum size in bytes, whether HEAD-pinned, and whether a multi-model review):

  code-review  code-review.md   200   multi-model review of the code diff
                                      (pinned, requires >=3 models and a final
                                      clean convergence round from 1 through 5)
  plan         plan.md          120   multi-model review of the plan
                                      (requires >=3 models)
  demo         demo.md          120   demo video + before/after images
                                      (or an explicit "N/A" justification)
  pr-review    pr-review.md     120   multi-model review of the PR body
                                      (requires >=3 models)
  tests        tests.md         120   machine-produced record of a full
                                      CI-equivalent check run passing green
                                      (pinned; written by `run-tests`)

The code-review and tests markers are HEAD-pinned: `write`/`run-tests` records
the current HEAD commit on the first line (`<!-- reviewed-commit: <sha> -->`),
and the marker is reported stale once HEAD moves past that commit, so an
artifact that never saw the shipping diff cannot satisfy the gate. Re-run and
rewrite the marker after any later commit.

The three review markers (code-review, plan, pr-review) also require a
multi-model review: `write` refuses them unless `--models` names >=3 distinct
models, and records them in a `<!-- reviewed-by-models: a, b, c -->` header, so
a lightweight single-pass self-review cannot satisfy a gate meant to require a
multi-model review. `status`/`check` and gh-guard reject a review marker that
declares fewer than 3 distinct models or names a prohibited model. Gemini models
are prohibited because they repeatedly fail in this workflow and delay reviews.
The demo and tests markers are exempt.
The code-review marker also requires `--convergence-rounds N`, where N is the
final panel round that found no new verified findings. `status`/`check` and
gh-guard accept rounds 1 through 99. The standard workflow remains capped at
5 rounds; higher values record explicitly authorized confirmation rounds.

The tests marker is machine-produced: `run-tests` requires a clean repository,
runs the test-quality evidence preflight and the given check commands, verifies
the repository stayed clean, and writes the marker only if every command exits
0. This makes the marker a byproduct of a real green run rather than a
self-reported note, so a bare `touch` or a note that forgot to run the checks
cannot satisfy the gate. Because the gate only checks for the result header
literal, a deliberate hand-forge of that literal still passes: the gate guards
against my own accidental shortcuts, not against self-forgery by the repo owner.

The branch directory name is percent-encoded. The encoding MUST stay identical
to gh-guard's inline computation:
  printf '%s' "$branch" | sed -e 's/%/%25/g' -e 's|/|%2F|g'
i.e. replace '%' with '%25' first, then '/' with '%2F'. `bin/test_pr_marker.py`
asserts this helper agrees with that exact sed pipeline, and that gh-guard's
byte floors, filenames, pin flags, and model requirement match KINDS. Giving
each branch its own directory (rather than suffixing the encoded branch onto
every filename) avoids collisions between, e.g., branch `x`'s plan marker and
branch `x.plan`'s code-review marker.

Native handoffs use `check --publication <actual gh argv>` and the producer's
opaque run/attempt locators. The helper reads the native verifier, not caller
proof JSON or old marker logs. Native evidence retains an earlier reviewed plan,
its implementation admission, final-head checks, and exact-body review. Native
policy caps cumulative code panels at ten; plan/description history stays
separate. Legacy marker metadata and its accepted round range are unchanged.

Usage:
  pr-marker path <kind>            print the marker file path for the current branch
  pr-marker artifacts-dir <kind>   print the sibling artifacts directory path
  pr-marker write <kind> [FILE] [--models a,b,c] [--convergence-rounds N]
                                   write marker content from FILE (or stdin if
                                   '-'/omitted); review kinds require >=3 --models,
                                   and code-review requires a clean round number
  pr-marker run-tests --cmd '<command>' [--cmd '<command>' ...]
                      [--base-ref REF] [--no-test-change-reason REASON]
                      [--narrow reason]
                                   run the evidence preflight and each check command;
                                   write the HEAD-pinned tests marker only if every
                                   command exits 0 and the repository stays clean
  pr-marker status                 show all five markers and whether each passes
  pr-marker check                  exit 0 only if every marker passes (fresh + over
                                   floor)
  pr-marker capabilities --json    describe native proof requirements, not readiness
  pr-marker check --publication <actual gh argv>
                                   verify native-located evidence without importing
                                   or rewriting markers or native history
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import unicodedata
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlsplit


@dataclass(frozen=True)
class Kind:
    """A marker kind and the validation rules enforced for it."""

    name: str
    filename: str
    min_bytes: int
    summary: str
    pinned: bool = False
    requires_models: bool = False
    requires_result: bool = False
    requires_convergence: bool = False


KINDS: dict[str, Kind] = {
    "code-review": Kind(
        "code-review",
        "code-review.md",
        200,
        "multi-model review of the code diff",
        pinned=True,
        requires_models=True,
        requires_convergence=True,
    ),
    "plan": Kind(
        "plan",
        "plan.md",
        120,
        "multi-model review of the plan",
        requires_models=True,
    ),
    "demo": Kind(
        "demo",
        "demo.md",
        120,
        "demo video + before/after images (or N/A justification)",
    ),
    "pr-review": Kind(
        "pr-review",
        "pr-review.md",
        120,
        "multi-model review of the PR description",
        requires_models=True,
    ),
    "tests": Kind(
        "tests",
        "tests.md",
        120,
        "machine-produced record of a full CI-equivalent check run "
        "(tests, lint, type-check, build) passing green in a Codespace",
        pinned=True,
        requires_result=True,
    ),
}

MARKER_SUBDIR = "copilot-pr-review"

# A pinned marker records the commit it reviewed on its first line so the gate
# can reject it once HEAD moves past that commit (a review that never saw the
# shipping diff). Keep this literal in sync with gh-guard's sed extraction.
REVIEWED_COMMIT_PREFIX = "<!-- reviewed-commit: "
REVIEWED_COMMIT_SUFFIX = " -->"

# A review marker (plan, code-review, pr-review) must declare which models
# reviewed it, so a lightweight single-pass self-review cannot satisfy a gate
# that is meant to require a multi-model review. The models are recorded in a
# header line (not position-pinned, so it coexists with the reviewed-commit
# line-1 header on the code-review marker); both pr-marker and gh-guard parse
# this same literal, splitting the inner list on commas and counting distinct
# case-insensitive names. Keep this format in sync with gh-guard's extraction.
REVIEWED_MODELS_PREFIX = "<!-- reviewed-by-models: "
REVIEWED_MODELS_SUFFIX = " -->"
MIN_MODELS = 3
PROHIBITED_MODEL_PREFIXES = ("gemini",)

# A code-review marker must record that its final review round was clean and
# how many rounds were needed. Both pr-marker and gh-guard enforce the exact
# header. The standard workflow is capped at 5 rounds, but an explicitly
# authorized confirmation beyond the cap must still be recorded accurately.
REVIEW_CONVERGENCE_PREFIX = "<!-- review-convergence: clean; rounds: "
REVIEW_CONVERGENCE_SUFFIX = " -->"
MIN_REVIEW_ROUNDS = 1
MAX_REVIEW_ROUNDS = 99

# A machine-produced marker (tests) must carry this exact header, written only
# by `run-tests` after every check command exits 0. `status`/`check` and gh-guard
# require it, so a bare `touch` or a note that forgot to run the checks cannot
# satisfy the gate. A deliberate hand-forge of this literal is out of scope: the
# gate guards against accidental shortcuts, not self-forgery by the repo owner.
# Keep this literal in sync with gh-guard's grep.
TESTS_RESULT_HEADER = "<!-- tests-result: passed -->"

NATIVE_PROTOCOL = "no-mistakes.publication/v1"
NATIVE_MAX_PAYLOAD = 4 << 20
NATIVE_LOCATORS = ("NO_MISTAKES_PUBLICATION_RUN", "NO_MISTAKES_PUBLICATION_ATTEMPT")
NATIVE_REVIEW_FIELDS = (
    "invocation_id agent requested_model served_model model_id model_provider "
    "head_sha subject_sha256 started_at completed_at outcome content"
)
NATIVE_MAX_REVIEW_ROUNDS = 10


def _native_policy() -> dict:
    return {
        "protocol": NATIVE_PROTOCOL,
        "artifacts": {
            kind.name: {"min_bytes": kind.min_bytes} for kind in KINDS.values()
        },
        "min_review_models": MIN_MODELS,
        "excluded_model_prefixes": list(PROHIBITED_MODEL_PREFIXES),
        "create_confirmation_env": "ZACK_CONFIRMED_PR_CREATE",
        "review_budget_scope": "code-only",
        "plan_order": "before-implementation",
        "max_review_rounds": NATIVE_MAX_REVIEW_ROUNDS,
        "requires_full_tests": True,
    }


def _git(*args: str, read_only: bool = False) -> str:
    """Run a git command and return stripped stdout, or raise on failure."""
    result = subprocess.run(
        ["git", *args],
        capture_output=True,
        text=True,
        check=True,
        env=(
            {**os.environ, "GIT_OPTIONAL_LOCKS": "0", "GIT_NO_LAZY_FETCH": "1"}
            if read_only
            else None
        ),
    )
    return result.stdout.strip()


def encode_branch(branch: str) -> str:
    """Percent-encode a branch name for use as a marker filename.

    Order matters: encode '%' before '/' so a literal '%2F' in a branch name is
    not confused with an encoded slash. This mirrors gh-guard's sed pipeline.
    """
    return branch.replace("%", "%25").replace("/", "%2F")


def marker_dir() -> Path:
    """Return the base `<git-dir>/copilot-pr-review` directory for this checkout.

    Uses `git rev-parse --absolute-git-dir`, which resolves to `<repo>/.git`
    for plain checkouts and to `<main>/.git/worktrees/<name>/` for worktrees.
    """
    git_dir = _git("rev-parse", "--absolute-git-dir")
    return Path(git_dir) / MARKER_SUBDIR


def current_branch() -> str:
    """Return the current branch name, or raise if on a detached HEAD.

    Uses `git symbolic-ref --short HEAD` rather than `rev-parse --abbrev-ref`
    so it also works before the first commit (an unborn branch), while still
    failing on a genuinely detached HEAD. gh-guard resolves the branch with the
    identical command, so both agree on the marker filename (and both fail the
    same way on a detached HEAD).
    """
    try:
        branch = _git("symbolic-ref", "--short", "HEAD")
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(
            "cannot resolve a branch name (detached HEAD?); "
            "check out a branch before writing markers"
        ) from exc
    if not branch:
        raise RuntimeError(
            "cannot resolve a branch name (detached HEAD?); "
            "check out a branch before writing markers"
        )
    return branch


def current_head() -> str | None:
    """Return the current HEAD commit SHA, or None on an unborn/detached repo."""
    try:
        return _git("rev-parse", "HEAD")
    except subprocess.CalledProcessError:
        return None


def dirty_worktree_entries() -> list[str]:
    """Return staged, unstaged, and untracked non-ignored status entries."""
    result = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z"],
        capture_output=True,
        check=True,
    )
    return [
        entry.decode("utf-8", errors="replace")
        for entry in result.stdout.split(b"\0")
        if entry
    ]


def test_quality_checker_path() -> Path:
    """Return the checker path beside this dotfiles checkout."""
    return (
        Path(__file__).resolve().parent.parent
        / ".copilot"
        / "skills"
        / "test-quality"
        / "check.py"
    )


def read_reviewed_commit(path: Path) -> str | None:
    """Return the reviewed-commit SHA recorded on a marker's first line, if any."""
    try:
        first_line = path.read_text(encoding="utf-8").splitlines()[0]
    except (OSError, IndexError):
        return None
    if first_line.startswith(REVIEWED_COMMIT_PREFIX) and first_line.endswith(
        REVIEWED_COMMIT_SUFFIX
    ):
        return first_line.removeprefix(REVIEWED_COMMIT_PREFIX).removesuffix(
            REVIEWED_COMMIT_SUFFIX
        )
    return None


def parse_models(raw: str | None) -> list[str]:
    """Split a comma-separated model list into distinct, case-insensitive names.

    Whitespace around each name is trimmed and empty entries dropped. Order is
    preserved and duplicates (ignoring case) are collapsed, so
    "Opus, opus , sonnet" yields ["Opus", "sonnet"]. Used both to validate the
    `--models` argument on write and to count declared models on read; gh-guard
    counts distinct names the same way (tr/sed/sort -u).
    """
    if not raw:
        return []
    distinct: list[str] = []
    seen: set[str] = set()
    for part in raw.split(","):
        name = part.strip()
        if not name:
            continue
        key = name.lower()
        if key in seen:
            continue
        seen.add(key)
        distinct.append(name)
    return distinct


def prohibited_models(models: list[str]) -> list[str]:
    """Return model names that are prohibited from multi-model reviews."""
    return [
        model for model in models if model.lower().startswith(PROHIBITED_MODEL_PREFIXES)
    ]


def read_reviewed_models(path: Path) -> list[str]:
    """Return the distinct models declared in a marker's reviewed-by-models header.

    Scans every line (the header is not position-pinned, so it can sit on line 2
    of a pinned code-review marker) and returns the models from the first header
    line found, or [] if there is none.
    """
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    for line in lines:
        if line.startswith(REVIEWED_MODELS_PREFIX) and line.endswith(
            REVIEWED_MODELS_SUFFIX
        ):
            inner = line.removeprefix(REVIEWED_MODELS_PREFIX).removesuffix(
                REVIEWED_MODELS_SUFFIX
            )
            return parse_models(inner)
    return []


def read_convergence_rounds(path: Path) -> int | None:
    """Return the validated clean convergence round count, if declared."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    convergence_lines = [
        line for line in lines if line.startswith("<!-- review-convergence:")
    ]
    if len(convergence_lines) != 1:
        return None
    canonical_headers = {
        f"{REVIEW_CONVERGENCE_PREFIX}{rounds}{REVIEW_CONVERGENCE_SUFFIX}": rounds
        for rounds in range(MIN_REVIEW_ROUNDS, MAX_REVIEW_ROUNDS + 1)
    }
    return canonical_headers.get(convergence_lines[0])


def has_result_header(path: Path) -> bool:
    """Return True if the marker carries the machine-produced tests-result header.

    The header is written only by `run-tests` after every check command exits 0,
    so requiring it stops a bare-touch or forgot-to-run file from satisfying the
    tests gate. A deliberate hand-forge of the literal still passes; the gate
    guards against accidental shortcuts by the repo owner, not self-forgery.
    gh-guard greps for the identical literal.
    """
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    return TESTS_RESULT_HEADER in lines


def branch_dir(branch: str | None = None) -> Path:
    """Return the per-branch marker directory `<...>/copilot-pr-review/<branch>`.

    The branch component is percent-encoded so a name containing `/` stays a
    single flat directory rather than a nested path.
    """
    if branch is None:
        branch = current_branch()
    return marker_dir() / encode_branch(branch)


def marker_path(kind: Kind, branch: str | None = None) -> Path:
    """Return the absolute marker file path for a kind on the given branch."""
    return branch_dir(branch) / kind.filename


def artifacts_dir(kind: Kind, branch: str | None = None) -> Path:
    """Return the sibling artifacts directory for a kind (e.g. demo.artifacts)."""
    return branch_dir(branch) / f"{kind.name}.artifacts"


def _resolve_kind(name: str) -> Kind:
    """Return the Kind for a name, exiting with a helpful error if unknown."""
    try:
        return KINDS[name]
    except KeyError:
        valid = ", ".join(KINDS)
        raise SystemExit(f"pr-marker: unknown kind '{name}' (valid: {valid})") from None


def cmd_path(args: argparse.Namespace) -> int:
    """Print the marker file path for a kind on the current branch."""
    print(marker_path(_resolve_kind(args.kind)))
    return 0


def cmd_artifacts_dir(args: argparse.Namespace) -> int:
    """Print the sibling artifacts directory for a kind."""
    print(artifacts_dir(_resolve_kind(args.kind)))
    return 0


def strip_generated_headers(content: str) -> str:
    """Remove headers previously generated by pr-marker before rewriting."""
    kept: list[str] = []
    for line in content.splitlines(keepends=True):
        normalized = line.rstrip("\r\n")
        is_generated = (
            (
                normalized.startswith(REVIEWED_COMMIT_PREFIX)
                and normalized.endswith(REVIEWED_COMMIT_SUFFIX)
            )
            or (
                normalized.startswith(REVIEWED_MODELS_PREFIX)
                and normalized.endswith(REVIEWED_MODELS_SUFFIX)
            )
            or normalized.startswith("<!-- review-convergence:")
            or normalized == TESTS_RESULT_HEADER
        )
        if not is_generated:
            kept.append(line)
    return "".join(kept)


def cmd_write(args: argparse.Namespace) -> int:
    """Write marker content from a file or stdin, refusing content below the floor."""
    kind = _resolve_kind(args.kind)
    if kind.requires_result:
        print(
            f"pr-marker: the {kind.name} marker is machine-produced; write it with "
            f"`pr-marker run-tests --cmd '<command>'` (it runs the checks and only "
            f"writes when every command exits 0), not `write`.",
            file=sys.stderr,
        )
        return 1
    if args.file in (None, "-"):
        content = sys.stdin.read()
    else:
        content = Path(args.file).read_text(encoding="utf-8")
    content = strip_generated_headers(content)

    # The byte floor applies to the review content the caller provides, not to
    # any reviewed-commit / reviewed-by-models header prepended below.
    size = len(content.encode("utf-8"))
    if size < kind.min_bytes:
        print(
            f"pr-marker: refusing to write {kind.name} marker: "
            f"content is {size} bytes, but the gate requires >= {kind.min_bytes}. "
            f"Write the real {kind.summary}.",
            file=sys.stderr,
        )
        return 1

    # A review marker must name the models that reviewed it (>= MIN_MODELS
    # distinct), so a single-pass self-review cannot satisfy a multi-model gate.
    models: list[str] = []
    if kind.requires_models:
        models = parse_models(args.models)
        blocked_models = prohibited_models(models)
        if blocked_models:
            print(
                f"pr-marker: refusing to write {kind.name} marker: "
                f"Gemini models are prohibited in multi-model reviews "
                f"({', '.join(blocked_models)}). Re-run those reviewers with "
                "Claude, GPT, or another available non-Gemini model.",
                file=sys.stderr,
            )
            return 1
        if len(models) < MIN_MODELS:
            print(
                f"pr-marker: refusing to write {kind.name} marker: "
                f"it records a {kind.summary}, which requires >= {MIN_MODELS} "
                f"distinct models, but --models gave {len(models)} "
                f"({', '.join(models) or 'none'}). Re-run the review across "
                f"different models and pass, e.g., "
                f"--models opus-4.8,sonnet-4.6,gpt-5.5.",
                file=sys.stderr,
            )
            return 1
    convergence_rounds: int | None = None
    if kind.requires_convergence:
        convergence_rounds = args.convergence_rounds
        if convergence_rounds is None:
            print(
                f"pr-marker: refusing to write {kind.name} marker: "
                "the code-review gate requires a final clean convergence round. "
                f"Pass --convergence-rounds {MIN_REVIEW_ROUNDS} through "
                f"{MAX_REVIEW_ROUNDS}.",
                file=sys.stderr,
            )
            return 1

    headers = ""
    pinned_sha: str | None = None
    if kind.pinned:
        head = current_head()
        if head is None:
            print(
                f"pr-marker: cannot pin the {kind.name} marker: no HEAD commit "
                "to review (unborn or detached). Commit the change first.",
                file=sys.stderr,
            )
            return 1
        pinned_sha = head
        headers += f"{REVIEWED_COMMIT_PREFIX}{head}{REVIEWED_COMMIT_SUFFIX}\n"
    if models:
        joined = ", ".join(models)
        headers += f"{REVIEWED_MODELS_PREFIX}{joined}{REVIEWED_MODELS_SUFFIX}\n"
    if convergence_rounds is not None:
        headers += (
            f"{REVIEW_CONVERGENCE_PREFIX}{convergence_rounds}"
            f"{REVIEW_CONVERGENCE_SUFFIX}\n"
        )
    content = headers + content

    path = marker_path(kind)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    note = f" (pinned to {pinned_sha[:12]})" if pinned_sha else ""
    models_note = f" [models: {', '.join(models)}]" if models else ""
    convergence_note = (
        f" [clean convergence: round {convergence_rounds}]"
        if convergence_rounds is not None
        else ""
    )
    print(
        f"pr-marker: wrote {size} bytes to {path}{note}{models_note}"
        f"{convergence_note}"
    )
    return 0


def _invalidate_tests_marker(kind: Kind, branch: str) -> str:
    """Remove a prior tests marker and return a note for the error message."""
    stale = marker_path(kind, branch)
    if not stale.exists():
        return ""
    stale.unlink()
    return " (removed the previous tests marker)"


def _run_test_quality_preflight(
    args: argparse.Namespace,
) -> tuple[int, dict[str, object]]:
    """Run the test-evidence checker and return its exit code and JSON result."""
    checker = test_quality_checker_path()
    if not checker.is_file():
        print(
            f"pr-marker run-tests: WARNING: test-quality checker not found at {checker}; "
            "continuing for compatibility with an older dotfiles checkout.",
            file=sys.stderr,
        )
        return (
            0,
            {
                "status": "unavailable",
                "evidence": "unavailable",
                "base_ref": None,
                "base_commit": None,
                "source_files": [],
                "test_files": [],
                "warning_count": 1,
                "waiver": args.no_test_change_reason,
            },
        )

    command = [sys.executable, str(checker), "--json"]
    if args.base_ref:
        command += ["--base", args.base_ref]
    if args.no_test_change_reason:
        command += ["--no-test-change-reason", args.no_test_change_reason]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        print(
            "pr-marker run-tests: test-quality checker returned invalid JSON.",
            file=sys.stderr,
        )
        if result.stdout:
            print(result.stdout, file=sys.stderr)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        return (2, {})
    if not isinstance(payload, dict):
        print(
            "pr-marker run-tests: test-quality checker JSON must be an object.",
            file=sys.stderr,
        )
        return (2, {})

    status = payload.get("status", "unknown")
    evidence = payload.get("evidence", "unknown")
    warnings = int(payload.get("warning_count", 0))
    print(
        f"pr-marker run-tests: test-quality preflight {status} "
        f"(evidence: {evidence}, warnings: {warnings})",
        file=sys.stderr,
    )
    for finding in payload.get("findings", []):
        if not isinstance(finding, dict):
            continue
        severity = str(finding.get("severity", "warning")).upper()
        rule = finding.get("rule", "unknown")
        message = finding.get("message", "")
        paths = finding.get("paths") or []
        paths_note = f" [{', '.join(str(path) for path in paths)}]" if paths else ""
        print(
            f"pr-marker run-tests: {severity} [{rule}] {message}{paths_note}",
            file=sys.stderr,
        )
    if result.stderr:
        print(result.stderr, file=sys.stderr)
    if result.returncode == 0 and (status != "passed" or evidence == "unavailable"):
        print(
            "pr-marker run-tests: the test-quality preflight did not analyze a "
            "branch diff; pass --base-ref <ref>.",
            file=sys.stderr,
        )
        return (1, payload)
    return (result.returncode, payload)


def cmd_run_tests(args: argparse.Namespace) -> int:
    """Run the check commands and write the `tests` marker only if all pass.

    Streams each command's output live (so a long full-suite run is watchable),
    records the exit codes as machine proof, and writes the HEAD-pinned marker
    only when every command exits 0. Any failure writes nothing and exits
    non-zero, so the gate stays blocked until a real green run exists.
    """
    kind = KINDS["tests"]
    branch = current_branch()
    head = current_head()
    if head is None:
        print(
            "pr-marker: cannot pin the tests marker: no HEAD commit "
            "(unborn or detached). Commit the change first.",
            file=sys.stderr,
        )
        return 1

    dirty_before = dirty_worktree_entries()
    if dirty_before:
        removed = _invalidate_tests_marker(kind, branch)
        print(
            "pr-marker run-tests: refusing to certify HEAD while the repository has "
            f"staged, unstaged, or untracked files{removed}:",
            file=sys.stderr,
        )
        for entry in dirty_before:
            print(f"  {entry}", file=sys.stderr)
        print(
            "Commit or remove the changes, then run the full checks again.",
            file=sys.stderr,
        )
        return 1

    commands = [c.strip() for c in args.cmd]
    if any(not c for c in commands):
        print(
            "pr-marker run-tests: refusing to run: an empty --cmd was given; "
            "pass the real check commands.",
            file=sys.stderr,
        )
        return 1

    quality_code, quality = _run_test_quality_preflight(args)
    if quality_code != 0:
        removed = _invalidate_tests_marker(kind, branch)
        print(
            "pr-marker run-tests: test-quality evidence preflight failed; "
            f"not running checks or writing the tests marker{removed}.",
            file=sys.stderr,
        )
        return 1

    codespace = args.codespace or os.environ.get("CODESPACE_NAME") or "unknown"
    results: list[tuple[str, int, float]] = []
    for cmd in commands:
        print(f"pr-marker run-tests: running: {cmd}", file=sys.stderr)
        start = time.monotonic()
        # shell=True runs the author-supplied check commands (make test, etc.)
        code = subprocess.run(cmd, shell=True).returncode
        duration = time.monotonic() - start
        results.append((cmd, code, duration))
        label = "passed" if code == 0 else f"FAILED (exit {code})"
        print(
            f"pr-marker run-tests: {label} in {duration:.1f}s: {cmd}",
            file=sys.stderr,
        )

    failed = [c for c, code, _ in results if code != 0]
    if failed:
        removed = _invalidate_tests_marker(kind, branch)
        print(
            f"pr-marker run-tests: {len(failed)} of {len(results)} command(s) failed; "
            f"not writing the tests marker{removed}.",
            file=sys.stderr,
        )
        return 1

    dirty_after = dirty_worktree_entries()
    if dirty_after:
        removed = _invalidate_tests_marker(kind, branch)
        print(
            "pr-marker run-tests: checks changed the repository, so the run cannot "
            f"certify HEAD{removed}:",
            file=sys.stderr,
        )
        for entry in dirty_after:
            print(f"  {entry}", file=sys.stderr)
        print(
            "Clean or commit the generated changes, then run the full checks again.",
            file=sys.stderr,
        )
        return 1

    try:
        final_branch = current_branch()
    except RuntimeError:
        final_branch = None
    final_head = current_head()
    if final_branch != branch or final_head != head:
        removed = _invalidate_tests_marker(kind, branch)
        print(
            "pr-marker run-tests: checks changed the branch or HEAD, so the run "
            f"cannot certify the starting commit{removed}:",
            file=sys.stderr,
        )
        print(f"  branch: {branch} -> {final_branch or 'detached'}", file=sys.stderr)
        print(f"  HEAD: {head} -> {final_head or 'unavailable'}", file=sys.stderr)
        print(
            "Restore the starting branch and commit, then run the full checks again.",
            file=sys.stderr,
        )
        return 1

    ran_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    source_files = quality.get("source_files") or []
    test_files = quality.get("test_files") or []
    warning_count = int(quality.get("warning_count", 0))
    waiver = quality.get("waiver") or "none"
    lines = [
        f"{REVIEWED_COMMIT_PREFIX}{head}{REVIEWED_COMMIT_SUFFIX}",
        TESTS_RESULT_HEADER,
        "# tests: full CI-equivalent check run",
        "",
        f"RESULT: passed (all {len(results)} command(s) exited 0)",
        f"Codespace: {codespace}",
        f"Ran at: {ran_at}",
        f"Commit: {head}",
        "",
        "Test-quality evidence preflight:",
        f"- status: {quality.get('status', 'unavailable')}",
        f"- evidence: {quality.get('evidence', 'unavailable')}",
        f"- base ref: {quality.get('base_ref') or 'unavailable'}",
        f"- base commit: {quality.get('base_commit') or 'unavailable'}",
        f"- executable source files changed: {len(source_files)}",
        f"- test files changed: {len(test_files)}",
        f"- warnings: {warning_count}",
        f"- no-test-change reason: {waiver}",
        "",
        "Commands:",
    ]
    lines += [f"- exit {code} in {dur:.1f}s: {cmd}" for cmd, code, dur in results]
    lines += ["", f"Narrowing: {args.narrow or 'none (full suite)'}"]
    content = "\n".join(lines) + "\n"

    path = marker_path(kind, branch)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    size = len(content.encode("utf-8"))
    print(
        f"pr-marker: wrote {size} bytes to {path} "
        f"(pinned to {head[:12]}) [tests: passed]"
    )
    return 0


class NativeProofError(RuntimeError):
    """A native handoff is unavailable, contradictory, or unsupported."""


def _native_object(value, required: str, optional: str = "", *, label: str) -> dict:
    required_keys = set(required.split())
    if not isinstance(value, dict) or not required_keys <= value.keys():
        raise NativeProofError(f"malformed {label}: missing required fields")
    if value.keys() - required_keys - set(optional.split()):
        raise NativeProofError(f"malformed {label}: unsupported fields")
    return value


def _native_text(value, label: str, *, empty: bool = False) -> str:
    if not isinstance(value, str) or (not empty and not value):
        raise NativeProofError(f"malformed {label}: expected a string")
    try:
        value.encode("utf-8")
    except UnicodeError as exc:
        raise NativeProofError(f"malformed {label}: invalid UTF-8") from exc
    return value


def _native_integer(value, label: str, minimum: int = 0) -> int:
    if type(value) is not int or not minimum <= value <= (1 << 63) - 1:
        raise NativeProofError(
            f"malformed {label}: expected an integer >= {minimum} within the native range"
        )
    return value


def _native_digest(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _native_sha(value, label: str, lengths=(40, 64)) -> str:
    value = _native_text(value, label)
    if len(value) not in lengths or any(c not in "0123456789abcdef" for c in value):
        raise NativeProofError(f"malformed {label}: expected a full hexadecimal digest")
    return value


def _native_model_id(raw) -> str:
    raw = _native_text(raw, "served model")
    if raw.count("/") > 1 or any(
        c.isspace() or unicodedata.category(c) == "Cc" for c in raw
    ):
        raise NativeProofError("unsupported native model spelling")
    parts = raw.split("/")
    if any(not part for part in parts):
        raise NativeProofError("unsupported native model spelling")
    # Go's strings.ToLower uses simple rune mapping, not Python's contextual
    # sigma or multi-codepoint dotted-I lowercasing.
    return "".join(character.lower()[0] for character in parts[-1])


def _native_decode(raw: bytes) -> dict:
    if not raw or len(raw) > NATIVE_MAX_PAYLOAD:
        raise NativeProofError("native proof is empty or exceeds the payload limit")

    def unique_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise NativeProofError("malformed native proof: duplicate JSON key")
            result[key] = value
        return result

    def invalid_constant(_value):
        raise NativeProofError("malformed native proof: non-JSON numeric constant")

    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=unique_object,
            parse_constant=invalid_constant,
        )
    except (ValueError, UnicodeError, RecursionError) as exc:
        raise NativeProofError("malformed native proof JSON") from exc
    pending = [(value, 0)]
    while pending:
        item, depth = pending.pop()
        if depth > 128:
            raise NativeProofError("malformed native proof: nesting limit exceeded")
        if isinstance(item, dict):
            pending.extend((child, depth + 1) for child in item.values())
        elif isinstance(item, list):
            pending.extend((child, depth + 1) for child in item)
    return _native_object(
        value,
        "protocol run_id attempt_id repo_id binding title body body_sha256 "
        "preparation_id plan preparation_admitted_at submitted_head_sha policy "
        "history_known total_code_rounds total_plan_rounds total_description_rounds artifacts",
        label="native proof",
    )


def _native_request(argv: list[str]) -> dict:
    if len(argv) < 2 or argv[0] != "pr" or argv[1] not in ("create", "edit"):
        raise NativeProofError(
            "unsupported native publication argv: expected pr create or pr edit"
        )
    request = {
        "operation": "create" if argv[1] == "create" else "update",
        "draft": False,
    }
    flags = {"--repo", "--body-file", "--title"}
    if request["operation"] == "create":
        flags |= {"--head", "--base"}
    index = 2
    while index < len(argv):
        arg = argv[index]
        flag, separator, value = arg.partition("=")
        if flag == "-R":
            flag = "--repo"
        key = flag.removeprefix("--")
        if flag in flags:
            if key in request:
                raise NativeProofError(f"duplicate native publication argument {flag}")
            if not separator:
                index += 1
                if index >= len(argv):
                    raise NativeProofError(
                        f"missing native publication argument {flag}"
                    )
                value = argv[index]
            if not value:
                raise NativeProofError(f"empty native publication argument {flag}")
            request[key] = value
        elif (
            arg == "--draft"
            and request["operation"] == "create"
            and not request["draft"]
        ):
            request["draft"] = True
        elif (
            request["operation"] == "update"
            and "selector" not in request
            and not arg.startswith("-")
        ):
            request["selector"] = arg
        else:
            raise NativeProofError(f"unsupported native publication argument {flag}")
        index += 1
    required = {flag.removeprefix("--") for flag in flags}
    if request["operation"] == "update":
        required = (required - {"title"}) | {"selector"}
    if not required <= request.keys():
        raise NativeProofError("missing required native publication arguments")
    return request


def _native_body(path: str) -> bytes:
    file = Path(path)
    if not file.is_absolute():
        raise NativeProofError(
            "native body file must be an absolute regular file, not stdin"
        )
    info = file.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_size > NATIVE_MAX_PAYLOAD:
        raise NativeProofError(
            "native body file must be a bounded regular file, not a symlink or stream"
        )
    body = file.read_bytes()
    if not body or len(body) > NATIVE_MAX_PAYLOAD:
        raise NativeProofError("native body file is empty or exceeds the payload limit")
    body.decode("utf-8")
    return body


def _native_context() -> dict:
    def git(*args):
        return _git(*args, read_only=True)

    worktree = Path.cwd().resolve()
    root = Path(git("rev-parse", "--show-toplevel")).resolve(strict=True)
    if worktree != root:
        raise NativeProofError(
            "native verification requires the actual source worktree root"
        )
    try:
        branch = git("symbolic-ref", "--quiet", "HEAD")
    except subprocess.CalledProcessError as exc:
        raise NativeProofError(
            "native verification requires a named branch, not detached HEAD"
        ) from exc
    if not branch.startswith("refs/heads/"):
        raise NativeProofError("native verification requires a named branch")
    head = git("rev-parse", "--verify", "HEAD^{commit}")
    _native_sha(head, "actual HEAD")
    store = Path(
        git("rev-parse", "--path-format=absolute", "--git-common-dir")
    ).resolve(strict=True)
    if git("status", "--porcelain=v1", "--untracked-files=all"):
        raise NativeProofError("native verification refuses a dirty worktree")
    return {
        "worktree": str(root),
        "requested_store": str(store),
        "branch": branch.removeprefix("refs/heads/"),
        "head_sha": head,
    }


def _native_output(argv: list[str]) -> bytes:
    # Spool bounded reads rather than retaining arbitrary producer output in RAM.
    with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as errors:
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=output,
            stderr=errors,
            timeout=30,
            env={
                **os.environ,
                "NO_MISTAKES_NO_UPDATE_CHECK": "1",
                "NO_MISTAKES_TELEMETRY": "0",
                "GIT_OPTIONAL_LOCKS": "0",
                "GIT_NO_LAZY_FETCH": "1",
            },
        )
        if result.returncode:
            raise NativeProofError(
                f"native verifier refused or is unavailable (exit {result.returncode})"
            )
        output.seek(0)
        raw = output.read(NATIVE_MAX_PAYLOAD + 1)
        if len(raw) > NATIVE_MAX_PAYLOAD:
            raise NativeProofError("native verifier output exceeds the payload limit")
        return raw


def _native_read_proof(
    context: dict, body_file: str, run_id: str, attempt_id: str
) -> dict:
    executable = shutil.which("no-mistakes")
    if not executable:
        raise NativeProofError(
            "trusted no-mistakes CLI is unavailable on the operator PATH"
        )
    executable = str(Path(executable).resolve(strict=True))
    help_text = _native_output([executable, "axi", "--help"]).decode("utf-8")
    commands = help_text.partition("Available Commands:")[2].partition("Flags:")[0]
    if not any(line.split()[:1] == ["publication"] for line in commands.splitlines()):
        raise NativeProofError(
            "selected no-mistakes CLI has no native publication verifier"
        )
    raw = _native_output(
        [
            executable,
            "axi",
            "publication",
            "verify",
            "--run",
            run_id,
            "--attempt",
            attempt_id,
            "--expected-store",
            context["requested_store"],
            "--branch",
            context["branch"],
            "--head",
            context["head_sha"],
            "--body-file",
            body_file,
            "--json",
        ]
    )
    return _native_decode(raw)


def _native_repo(raw, *, default_host="github.com") -> tuple[str, str, str]:
    parts = _native_text(raw, "repository").split("/")
    if len(parts) == 2:
        parts.insert(0, default_host)
    if len(parts) != 3 or any(not p or any(c.isspace() for c in p) for p in parts):
        raise NativeProofError("malformed native repository identity")
    return tuple(part.lower() for part in parts)


def _native_binding(
    proof: dict, request: dict, context: dict, body: bytes, ids: tuple
) -> dict:
    if (
        proof["protocol"] != NATIVE_PROTOCOL
        or (proof["run_id"], proof["attempt_id"]) != ids
    ):
        raise NativeProofError("native producer/run/attempt identity mismatch")
    for key in ("repo_id", "preparation_id"):
        _native_text(proof[key], key)
    binding = _native_object(
        proof["binding"],
        "requested_store worktree branch head_sha repository head_repository base_branch draft operation push_target before_push",
        "pr_url previous_body_sha256",
        label="native binding",
    )
    for key, expected in context.items():
        if binding[key] != expected:
            raise NativeProofError(f"native {key} mismatch")
    for key in ("draft", "before_push"):
        if type(binding[key]) is not bool:
            raise NativeProofError(f"malformed native {key}")
    _native_text(binding["push_target"], "native push target")
    _native_text(binding["base_branch"], "native base branch")
    if binding["operation"] != request["operation"]:
        raise NativeProofError("native publication operation mismatch")
    repo = _native_repo(binding["repository"])
    head_repo = _native_repo(binding["head_repository"], default_host=repo[0])
    if head_repo[0] != repo[0]:
        raise NativeProofError("native head repository belongs to a different forge")
    if repo != _native_repo(request["repo"]):
        raise NativeProofError("native target repository mismatch")
    title = _native_text(proof["title"], "native title", empty=True)
    if request.get("title", "") != title:
        raise NativeProofError("native title mismatch")
    certified_body = _native_text(proof["body"], "native body")
    if certified_body.encode("utf-8") != body or proof["body_sha256"] != _native_digest(
        certified_body
    ):
        raise NativeProofError("native exact body mismatch")
    if request["operation"] == "create":
        if (
            binding["base_branch"] != request["base"]
            or binding["draft"] != request["draft"]
        ):
            raise NativeProofError("native base/draft mismatch")
        head = request["head"]
        owner, colon, branch = head.partition(":")
        if colon:
            matches = (
                owner.lower() == head_repo[1]
                and branch == context["branch"]
                and head_repo[0] == repo[0]
            )
        else:
            matches = head == context["branch"] and head_repo == repo
        if not matches:
            raise NativeProofError("native head repository/branch selector mismatch")
        if (
            binding.get("pr_url")
            or binding.get("previous_body_sha256")
            or binding["before_push"]
        ):
            raise NativeProofError("unsupported native create binding")
    else:
        try:
            url = urlsplit(_native_text(binding.get("pr_url"), "native update URL"))
        except ValueError as exc:
            raise NativeProofError("malformed native update URL") from exc
        parts = url.path.split("/")
        if (
            url.scheme not in ("https", "http")
            or url.username
            or url.password
            or url.query
            or url.fragment
            or len(parts) != 5
            or parts[3] != "pull"
            or not parts[4].isascii()
            or not parts[4].isdigit()
            or int(parts[4]) < 1
        ):
            raise NativeProofError("malformed native update URL")
        if (url.netloc.lower(), parts[1].lower(), parts[2].lower()) != repo:
            raise NativeProofError("native update repository mismatch")
        if request["selector"] not in (binding["pr_url"], parts[4]):
            raise NativeProofError("native update selector mismatch")
        _native_sha(binding.get("previous_body_sha256"), "native previous body", (64,))
    return binding


def _native_artifact(value, kind: Kind, subject: str, *, label: str) -> dict:
    artifact = _native_object(
        value,
        "content sha256 bytes round_id subject_sha256",
        "reviews attempts checks observations",
        label=f"{label} artifact",
    )
    content = _native_text(artifact["content"], f"{label} content")
    size = _native_integer(artifact["bytes"], f"{label} bytes")
    if (
        size != len(content.encode("utf-8"))
        or size < kind.min_bytes
        or artifact["sha256"] != _native_digest(content)
    ):
        raise NativeProofError(f"native {label} artifact floor/digest mismatch")
    _native_text(artifact["round_id"], f"{label} round identity")
    actual = _native_sha(artifact["subject_sha256"], f"{label} subject", (64,))
    if actual != subject:
        raise NativeProofError(f"native {label} subject is stale")
    return artifact


def _native_checks(
    artifact: dict,
    head: str,
    *,
    admitted_at: int = 1,
    plan_completed_at: int | None = None,
) -> tuple[list[str], int]:
    label = "baseline " if plan_completed_at is not None else ""
    checks = artifact.get("checks")
    if not isinstance(checks, list) or not checks:
        raise NativeProofError(f"native {label}machine checks are missing")
    commands = []
    completed = 0
    for check in checks:
        check = _native_object(
            check,
            "command exit_code started_at completed_at head_sha output",
            label=f"{label}machine check",
        )
        commands.append(_native_text(check["command"], f"{label}machine check command"))
        _native_text(check["output"], f"{label}machine check output", empty=True)
        start = _native_integer(check["started_at"], f"{label}machine check start", 1)
        end = _native_integer(
            check["completed_at"], f"{label}machine check completion", start
        )
        if (
            type(check["exit_code"]) is not int
            or check["exit_code"] != 0
            or check["head_sha"] != head
            or start < admitted_at
            or (plan_completed_at is not None and end > plan_completed_at)
        ):
            boundary = (
                "before plan completion"
                if plan_completed_at is not None
                else "on the final head after implementation admission"
            )
            raise NativeProofError(
                f"native {label}machine checks did not pass {boundary}"
            )
        completed = max(completed, end)
    return commands, completed


def _native_evidence(proof: dict, binding: dict) -> None:
    policy = _native_object(
        proof["policy"], " ".join(_native_policy()), label="native policy"
    )
    requirements = _native_object(
        policy["artifacts"], " ".join(KINDS), label="artifact requirements"
    )
    for kind in KINDS.values():
        rule = _native_object(
            requirements[kind.name], "min_bytes", label=f"{kind.name} requirement"
        )
        if type(rule["min_bytes"]) is not int or rule["min_bytes"] != kind.min_bytes:
            raise NativeProofError(f"native {kind.name} byte-floor policy mismatch")
    if (
        policy["protocol"] != NATIVE_PROTOCOL
        or type(policy["min_review_models"]) is not int
        or policy["min_review_models"] != MIN_MODELS
        or policy["excluded_model_prefixes"] != list(PROHIBITED_MODEL_PREFIXES)
        or policy["create_confirmation_env"] != "ZACK_CONFIRMED_PR_CREATE"
        or policy["requires_full_tests"] is not True
    ):
        raise NativeProofError("native review/test/confirmation policy mismatch")
    if policy["plan_order"] != "before-implementation":
        raise NativeProofError("native plan ordering policy mismatch")
    ceiling = _native_integer(policy["max_review_rounds"], "native review ceiling", 1)
    if (
        ceiling != NATIVE_MAX_REVIEW_ROUNDS
        or policy["review_budget_scope"] != "code-only"
    ):
        raise NativeProofError("native code-only review budget policy mismatch")
    if proof["history_known"] is not True:
        raise NativeProofError("native review history is unknown")
    counts = [
        _native_integer(proof[key], key, 1)
        for key in (
            "total_code_rounds",
            "total_plan_rounds",
            "total_description_rounds",
        )
    ]
    if counts[0] > ceiling:
        raise NativeProofError("native cumulative review budget is exhausted")
    plan = _native_object(
        proof["plan"],
        "run_id repo_id branch requested_store worktree baseline_sha intent_sha256 "
        "plan_text plan_sha256 checks artifact policy execution_config_sha256 completed_at",
        label="pre-implementation plan",
    )
    earlier_run = _native_text(plan["run_id"], "earlier preparation run")
    if (
        earlier_run == proof["run_id"]
        or plan["repo_id"] != proof["repo_id"]
        or any(
            plan[key] != binding[key]
            for key in ("branch", "requested_store", "worktree")
        )
    ):
        raise NativeProofError("native pre-implementation plan context mismatch")
    baseline = _native_sha(plan["baseline_sha"], "prepared baseline")
    _native_sha(proof["submitted_head_sha"], "submitted head")
    for key in ("intent_sha256", "execution_config_sha256"):
        _native_sha(plan[key], f"plan {key}", (64,))
    plan_text = _native_text(plan["plan_text"], "prospective plan")
    if plan["plan_sha256"] != _native_digest(plan_text):
        raise NativeProofError("native pre-implementation plan subject mismatch")
    plan_completed = _native_integer(plan["completed_at"], "plan completion", 1)
    admitted = _native_integer(
        proof["preparation_admitted_at"], "preparation admission", plan_completed
    )
    # Compare typed JSON rather than Python equality (True == 1 == 1.0).
    if json.dumps(plan["policy"], sort_keys=True) != json.dumps(policy, sort_keys=True):
        raise NativeProofError("native policy differs from pre-implementation plan")
    artifacts = _native_object(
        proof["artifacts"], " ".join(KINDS), label="native artifacts"
    )
    for kind in KINDS.values():
        subject = (
            plan["plan_sha256"]
            if kind.name == "plan"
            else (
                proof["body_sha256"]
                if kind.name == "pr-review"
                else _native_digest(binding["head_sha"])
            )
        )
        _native_artifact(artifacts[kind.name], kind, subject, label=kind.name)
    if json.dumps(plan["artifact"], sort_keys=True) != json.dumps(
        artifacts["plan"], sort_keys=True
    ):
        raise NativeProofError(
            "native pre-implementation plan was replaced or relabeled"
        )
    baseline_tests = _native_artifact(
        plan["checks"], KINDS["tests"], _native_digest(baseline), label="baseline tests"
    )
    baseline_commands, baseline_completed = _native_checks(
        baseline_tests, baseline, plan_completed_at=plan_completed
    )
    commands, tests_completed = _native_checks(
        artifacts["tests"], binding["head_sha"], admitted_at=admitted
    )
    # The native verifier owns the pinned manifest and its actual execution;
    # matching two arbitrary lists is not proof of required-suite completeness.
    if commands != baseline_commands:
        raise NativeProofError(
            "native final checks differ from the prepared command manifest"
        )
    if (
        not isinstance(artifacts["demo"].get("observations"), dict)
        or not artifacts["demo"]["observations"]
    ):
        raise NativeProofError("native demo observations are missing")
    invocations = set()
    for kind in ("plan", "code-review", "pr-review"):
        artifact = artifacts[kind]
        reviews, attempts = artifact.get("reviews"), artifact.get("attempts")
        if (
            not isinstance(reviews, list)
            or not isinstance(attempts, list)
            or not attempts
        ):
            raise NativeProofError(
                f"native {kind} review/attempt provenance is missing"
            )
        recorded_attempts = {}
        for attempt in attempts:
            attempt = _native_object(
                attempt, NATIVE_REVIEW_FIELDS, label=f"{kind} attempt"
            )
            identity = _native_text(attempt["invocation_id"], "attempt invocation")
            if identity in recorded_attempts or attempt["outcome"] not in (
                "returned",
                "failed",
            ):
                raise NativeProofError(f"native {kind} has malformed attempt history")
            for field in (
                "agent",
                "requested_model",
                "served_model",
                "model_id",
                "model_provider",
                "content",
            ):
                _native_text(attempt[field], f"attempt {field}", empty=True)
            start = _native_integer(attempt["started_at"], "attempt start", 1)
            _native_integer(attempt["completed_at"], "attempt completion", start)
            _native_sha(attempt["head_sha"], "attempt head")
            if attempt["subject_sha256"] != artifact["subject_sha256"]:
                raise NativeProofError(f"native {kind} attempt subject mismatch")
            recorded_attempts[identity] = attempt
        models = set()
        for review in reviews:
            review = _native_object(
                review, NATIVE_REVIEW_FIELDS, label=f"{kind} review"
            )
            identity = _native_text(review["invocation_id"], "review invocation")
            _native_text(review["agent"], "review agent")
            _native_text(review["model_provider"], "review provider", empty=True)
            requested = _native_text(review["requested_model"], "requested model")
            _native_model_id(requested)
            model = _native_model_id(review["served_model"])
            if (
                review["model_id"] != model
                or requested.strip().rsplit("/", 1)[-1].strip()
                != review["served_model"].rsplit("/", 1)[-1]
            ):
                raise NativeProofError(
                    f"native {kind} requested/served model identity mismatch"
                )
            if prohibited_models([model]) or model in models or identity in invocations:
                raise NativeProofError(
                    f"native {kind} has prohibited or duplicate reviewers"
                )
            start = _native_integer(review["started_at"], "review start", 1)
            end = _native_integer(review["completed_at"], "review completion", start)
            _native_sha(review["head_sha"], "reviewed head")
            head = baseline if kind == "plan" else binding["head_sha"]
            checks_completed = baseline_completed if kind == "plan" else tests_completed
            if review["head_sha"] != head or start < checks_completed:
                boundary = "baseline" if kind == "plan" else "final-head"
                raise NativeProofError(
                    f"native {kind} review preceded passing {boundary} checks or is stale"
                )
            if kind == "plan" and end > plan_completed:
                raise NativeProofError(
                    "native plan review completed after the preparation receipt"
                )
            if (
                review["subject_sha256"] != artifact["subject_sha256"]
                or review["outcome"] != "clean"
                or not _native_text(review["content"], "review content").strip()
            ):
                raise NativeProofError(
                    f"native {kind} has no clean review of the exact subject"
                )
            attempt = recorded_attempts.get(identity)
            if (
                not attempt
                or attempt["outcome"] != "returned"
                or any(
                    attempt[field] != value
                    for field, value in review.items()
                    if field not in ("outcome", "content")
                )
            ):
                raise NativeProofError(
                    f"native {kind} clean review does not match its recorded attempt"
                )
            models.add(model)
            invocations.add(identity)
        if len(models) < MIN_MODELS:
            raise NativeProofError(f"native {kind} has insufficient distinct reviewers")


def cmd_native_check(argv: list[str]) -> int:
    try:
        ids = tuple(os.environ.get(key, "") for key in NATIVE_LOCATORS)
        if not all(ids):
            raise NativeProofError(
                "both native run/attempt locators are required and must be nonempty"
            )
        request = _native_request(argv)
        if (
            request["operation"] == "create"
            and os.environ.get("ZACK_CONFIRMED_PR_CREATE") != "1"
        ):
            raise NativeProofError(
                "native creation requires same-call ZACK_CONFIRMED_PR_CREATE=1"
            )
        context = _native_context()
        body = _native_body(request["body-file"])
        proof = _native_read_proof(context, request["body-file"], *ids)
        if _native_context() != context or _native_body(request["body-file"]) != body:
            raise NativeProofError(
                "Git context or exact body changed during native verification"
            )
        binding = _native_binding(proof, request, context, body, ids)
        _native_evidence(proof, binding)
        return 0
    except (NativeProofError, OSError, UnicodeError, subprocess.SubprocessError) as exc:
        print(f"pr-marker: native publication: {exc}", file=sys.stderr)
        return 1


def cmd_capabilities(_args: argparse.Namespace) -> int:
    print(json.dumps(_native_policy(), sort_keys=True))
    return 0


def marker_status(kind: Kind, branch: str) -> tuple[bool, str, int, Path]:
    """Return (ok, detail, size_bytes, path).

    detail is one of: "ok", "missing", "too small", "stale" (pinned marker whose
    reviewed-commit no longer equals HEAD), "needs models" (fewer than MIN_MODELS
    declared), "prohibited models" (a banned model is declared),
    "needs convergence" (no valid final-clean-round metadata), or "no result"
    (a requires_result marker missing the machine header).
    """
    path = marker_path(kind, branch)
    if not path.is_file():
        return (False, "missing", 0, path)
    size = path.stat().st_size
    if size < kind.min_bytes:
        return (False, "too small", size, path)
    if kind.pinned:
        recorded = read_reviewed_commit(path)
        head = current_head()
        if not recorded or not head or recorded != head:
            return (False, "stale", size, path)
    if kind.requires_models:
        models = read_reviewed_models(path)
        if prohibited_models(models):
            return (False, "prohibited models", size, path)
        if len(models) < MIN_MODELS:
            return (False, "needs models", size, path)
    if kind.requires_convergence and read_convergence_rounds(path) is None:
        return (False, "needs convergence", size, path)
    if kind.requires_result and not has_result_header(path):
        return (False, "no result", size, path)
    return (True, "ok", size, path)


def cmd_status(_args: argparse.Namespace) -> int:
    """Print each marker's status and whether the gate would pass."""
    branch = current_branch()
    print(f"branch: {branch}")
    print(f"marker dir: {branch_dir(branch)}")
    print()
    all_ok = True
    for kind in KINDS.values():
        ok, detail, size, path = marker_status(kind, branch)
        all_ok = all_ok and ok
        mark = "ok " if ok else detail.upper()
        pin = " pinned" if kind.pinned else ""
        print(
            f"  [{mark:>9}] {kind.name:<12} {size:>5}B (>= {kind.min_bytes}B)  "
            f"{path.name}{pin}"
        )
    print()
    if any(key in os.environ for key in NATIVE_LOCATORS):
        print(
            "gate would BLOCK: native handoff needs check --publication with actual gh argv; legacy markers are not certification"
        )
        return 1
    if all_ok:
        print("all markers satisfied")
    else:
        print("gate would BLOCK: fill the missing/stale markers")
        print(
            "(a STALE pinned marker means HEAD moved since it was written; "
            "re-run it and rewrite so it re-pins to the current HEAD)"
        )
    return 0 if all_ok else 1


def cmd_check(args: argparse.Namespace) -> int:
    """Require legacy markers, or validate the explicitly requested native handoff."""
    if args.publication is not None:
        return cmd_native_check(args.publication)
    if any(key in os.environ for key in NATIVE_LOCATORS):
        print(
            "pr-marker: native handoff requires --publication with actual gh argv; legacy markers are not proof",
            file=sys.stderr,
        )
        return 1
    branch = current_branch()
    failures = []
    for kind in KINDS.values():
        ok, detail, _size, path = marker_status(kind, branch)
        if not ok:
            failures.append((detail, kind, path))
    if failures:
        for detail, kind, path in failures:
            print(
                f"pr-marker: {detail} {kind.name} marker at {path}",
                file=sys.stderr,
            )
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    """Build the argparse parser for the pr-marker subcommands."""
    parser = argparse.ArgumentParser(
        prog="pr-marker",
        description="Read/write the per-branch PR-readiness markers gh-guard gates on.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_path = sub.add_parser("path", help="print the marker file path for a kind")
    p_path.add_argument("kind", help="one of: " + ", ".join(KINDS))
    p_path.set_defaults(func=cmd_path)

    p_art = sub.add_parser(
        "artifacts-dir", help="print the sibling artifacts dir for a kind"
    )
    p_art.add_argument("kind", help="one of: " + ", ".join(KINDS))
    p_art.set_defaults(func=cmd_artifacts_dir)

    p_write = sub.add_parser("write", help="write marker content from a file or stdin")
    p_write.add_argument("kind", help="one of: " + ", ".join(KINDS))
    p_write.add_argument(
        "file", nargs="?", default="-", help="file to read (default: stdin)"
    )
    p_write.add_argument(
        "--models",
        default=None,
        help=(
            "comma-separated models that reviewed this marker; required for "
            f"review kinds (>= {MIN_MODELS} distinct), e.g. "
            "opus-4.8,sonnet-4.6,gpt-5.5"
        ),
    )
    p_write.add_argument(
        "--convergence-rounds",
        type=int,
        choices=range(MIN_REVIEW_ROUNDS, MAX_REVIEW_ROUNDS + 1),
        default=None,
        help=(
            "round number whose multi-model code review found no new verified "
            "findings; required for code-review"
        ),
    )
    p_write.set_defaults(func=cmd_write)

    p_status = sub.add_parser("status", help="show all markers and whether each passes")
    p_status.set_defaults(func=cmd_status)

    p_check = sub.add_parser("check", help="exit 0 only if every marker passes")
    p_check.add_argument(
        "--publication",
        nargs=argparse.REMAINDER,
        metavar="GH_ARGV",
        help="check the native-located handoff against actual gh argv; imports no caller proof",
    )
    p_check.set_defaults(func=cmd_check)

    p_capabilities = sub.add_parser(
        "capabilities",
        help="describe native publication requirements, not producer readiness",
    )
    p_capabilities.add_argument("--json", action="store_true")
    p_capabilities.set_defaults(func=cmd_capabilities)

    p_run = sub.add_parser(
        "run-tests",
        help="run check commands and write the tests marker only if all pass",
    )
    p_run.add_argument(
        "--cmd",
        action="append",
        required=True,
        metavar="COMMAND",
        help=(
            "a check command to run (repeatable), e.g. "
            "--cmd 'make test' --cmd 'make lint'"
        ),
    )
    p_run.add_argument(
        "--codespace",
        default=None,
        help="Codespace name to record (defaults to $CODESPACE_NAME)",
    )
    p_run.add_argument(
        "--narrow",
        default=None,
        help=(
            "record an explicit infeasibility narrowing "
            "(genuine infeasibility only, never slowness)"
        ),
    )
    p_run.add_argument(
        "--base-ref",
        default=None,
        help=(
            "base branch/ref for the test-quality diff "
            "(defaults to environment/default-branch inference)"
        ),
    )
    p_run.add_argument(
        "--no-test-change-reason",
        default=None,
        help=(
            "specific reason executable source changed without a committed test "
            "change; recorded in the tests marker"
        ),
    )
    p_run.set_defaults(func=cmd_run_tests)

    return parser


def _reorder_write_argv(argv: list[str]) -> list[str]:
    """Move write options after the positionals so argparse binds FILE.

    argparse mis-handles a `nargs='?'` positional that follows an optional inside
    a subparser: `write pr-review --models a,b,c -` fails to bind the trailing
    `-` to `file`. Normalizing so the optional trails the positionals (the order
    argparse does handle) lets callers pass `--models` in the natural place,
    including the `--models a,b,c -` form the gh-guard help suggests.     Other commands pass through untouched.
    """
    if not argv or argv[0] != "write":
        return argv
    rest = argv[1:]
    option_tokens: list[str] = []
    others: list[str] = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg in ("--models", "--convergence-rounds"):
            option_tokens.append(arg)
            if i + 1 < len(rest):
                option_tokens.append(rest[i + 1])
                i += 2
                continue
        elif arg.startswith("--models=") or arg.startswith("--convergence-rounds="):
            option_tokens.append(arg)
        else:
            others.append(arg)
        i += 1
    return ["write", *others, *option_tokens]


def main(argv: list[str] | None = None) -> int:
    """Parse args and dispatch to the selected subcommand."""
    if argv is None:
        argv = sys.argv[1:]
    argv = _reorder_write_argv(argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except subprocess.CalledProcessError:
        print(
            "pr-marker: not inside a git checkout (git rev-parse failed)",
            file=sys.stderr,
        )
        return 2
    except (RuntimeError, OSError) as exc:
        print(f"pr-marker: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
