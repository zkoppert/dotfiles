#!/bin/bash
# gh wrapper that guards specific gh subcommands against accidental or
# unconfirmed use:
#
#   1. `gh pr ready`  - marks a draft PR ready and notifies reviewers.
#   2. `gh pr create` - opens a PR. Zack's staged change workflow requires four
#      multi-model review / demo artifacts before a PR is opened, so this
#      wrapper blocks PR creation until all four marker files exist in the
#      per-branch directory <git-dir>/copilot-pr-review/<encoded-branch>/:
#        - plan review          plan.md         (>=120 bytes, >=3 models)
#        - code review          code-review.md  (>=200 bytes, HEAD-pinned,
#                                                >=3 models)
#        - demo/before-after     demo.md         (>=120 bytes)
#        - PR-description review pr-review.md    (>=120 bytes, >=3 models)
#      Write them with the bin/pr-marker helper. The code-review marker is
#      HEAD-pinned: it records the reviewed commit and is rejected as STALE once
#      HEAD moves past it, so late commits force a re-review. The three review
#      markers must also declare >=3 distinct models in a reviewed-by-models
#      header (pr-marker `--models a,b,c`), so a single-pass self-review cannot
#      satisfy a gate meant to require a multi-model review. Additionally, the
#      PR body is piped through the `validate-style` lint skill and the create is
#      blocked if any hard-rule violations are reported (em-dashes, "per" misuse,
#      "This PR" as a sentence subject, subjectless action-verb bullets, etc.).
#   3. `gh pr edit`   - if `--body` or `--body-file` is provided, the new
#      body content is piped through the same `validate-style` lint skill
#      and the edit is blocked if any hard-rule violations are reported.
#      Edits that touch only title, labels, reviewers, base, milestone,
#      etc. are not gated. This closes the loop where post-create body
#      edits would otherwise bypass the `pr create` lint.
#
# Behavior:
#   - In an interactive shell (TTY): prompt for confirmation before running.
#   - In a non-interactive shell (e.g., an agent's bash tool): refuse unless
#     the per-command confirmation condition is met.
#
# Per-command confirmation:
#   - `gh pr ready`:  set ZACK_CONFIRMED_PR_READY=1 in the same invocation.
#   - `gh pr create`: write all four per-branch review/demo markers under
#       <git-dir>/copilot-pr-review/ (use `pr-marker write <kind> -`)
#     AND set ZACK_CONFIRMED_PR_CREATE=1 in the same invocation. `<git-dir>` is
#     the per-checkout git directory as reported by `git rev-parse
#     --absolute-git-dir`, so worktrees resolve to the per-worktree gitdir
#     (e.g. `<main>/.git/worktrees/<name>/copilot-pr-review/`) rather than the
#     gitlink file at `<worktree>/.git`. Each marker must meet its byte floor
#     so a bare `touch` does not satisfy it - actual review/demo content has to
#     land there before the PR can be opened. Both conditions are required
#     when invoked inside a git checkout. If the wrapper cannot resolve the
#     current repo or branch (e.g., `gh pr create` invoked outside a checkout
#     or on detached HEAD), the env var alone is accepted as a fallback
#     because no marker path can be derived.
#
# Known limitations (PATH-shim is a soft guard, not adversarial):
#   - `gh api repos/.../pulls` and `gh api graphql` createPullRequest mutations
#     are NOT gated. Guarding all of `gh api` would block too much. Treat the
#     wrapper as a convention enforcer, not an adversarial gate.
#   - User-defined `gh alias` expansions (e.g. `gh alias set prc 'pr create'`)
#     bypass the matcher because aliases are resolved inside real `gh` after
#     the wrapper has already dispatched. Avoid aliasing the guarded
#     subcommands.
#   - Direct invocation by real path (e.g. `~/repos/dotfiles/bin/gh-guard`)
#     instead of via the `~/.local/bin/gh` symlink can pick the symlink back
#     as REAL_GH and fork-recurse. Use the symlink, not the real path.
#
# Install:
#   ln -sf "$PWD/bin/gh-guard" ~/.local/bin/gh
#   Then ensure ~/.local/bin is first on PATH.
#
# Pass-through:
#   Every gh subcommand other than the guarded ones is exec'd against the
#   real gh binary with no modifications.

set -euo pipefail

# Find the real gh binary by skipping our own directory in PATH.
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF_REAL_PATH="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)"

REAL_GH=""
IFS=':' read -ra PATH_ENTRIES <<< "$PATH"
for entry in "${PATH_ENTRIES[@]}"; do
  [ -z "$entry" ] && continue
  candidate="$entry/gh"
  [ ! -x "$candidate" ] && continue
  resolved_dir="$(cd "$entry" 2>/dev/null && pwd || echo "$entry")"
  if [ "$resolved_dir" = "$SCRIPT_PATH" ] || [ "$resolved_dir" = "$SELF_REAL_PATH" ]; then
    continue
  fi
  REAL_GH="$candidate"
  break
done

if [ -z "$REAL_GH" ]; then
  echo "gh-guard: real gh binary not found in PATH" >&2
  echo "gh-guard: PATH=$PATH" >&2
  exit 127
fi

# Parse the subcommand and operation, accounting for gh's global flags that
# may precede the subcommand (e.g. `gh -R owner/repo pr ready`).
subcmd=""
op=""
{
  args=("$@")
  i=0
  while [ $i -lt ${#args[@]} ]; do
    arg="${args[$i]}"
    case "$arg" in
      -R|--repo|-H|--hostname|--token)
        i=$((i + 2))
        ;;
      --repo=*|--hostname=*|--token=*|--*=*)
        i=$((i + 1))
        ;;
      --version|--help|-h)
        break
        ;;
      -*)
        i=$((i + 1))
        ;;
      *)
        if [ -z "$subcmd" ]; then
          subcmd="$arg"
          i=$((i + 1))
        elif [ -z "$op" ]; then
          op="$arg"
          break
        fi
        ;;
    esac
  done
}

is_pr_ready=0
is_pr_create=0
is_pr_edit=0
if [ "$subcmd" = "pr" ] && [ "$op" = "ready" ]; then
  is_pr_ready=1
  # `--undo` reverts a ready PR back to draft and does NOT notify reviewers,
  # so it should not trigger the guard.
  for a in "$@"; do
    if [ "$a" = "--undo" ]; then
      is_pr_ready=0
      break
    fi
  done
elif [ "$subcmd" = "pr" ] && [ "$op" = "create" ]; then
  is_pr_create=1
elif [ "$subcmd" = "pr" ] && [ "$op" = "edit" ]; then
  is_pr_edit=1
fi

# Help flags after the op (e.g. `gh pr create --help`, `gh pr ready -h`) are
# not seen by the parser above because it breaks at `op`. Scan the full
# argument list and let help requests pass through unguarded so agents can
# introspect flags without tripping the gate.
if [ "$is_pr_create" = "1" ] || [ "$is_pr_ready" = "1" ] || [ "$is_pr_edit" = "1" ]; then
  for a in "$@"; do
    case "$a" in
      --help|-h|help)
        is_pr_create=0
        is_pr_ready=0
        is_pr_edit=0
        break
        ;;
    esac
  done
fi

# Extract a PR body from `--body` / `--body-file` flags (in any of the four
# forms: `--body x`, `--body=x`, `--body-file p`, `--body-file=p`) and pipe
# it through the validate-style lint skill. Blocks the calling subcommand
# with a clear violation list if the lint reports any hard-rule failures.
# Silently passes if no body flag is present (e.g., a `gh pr edit` that
# only changes labels, or a `gh pr create` that opens the editor).
#
# Args:
#   $1 - human-readable subcommand label for the error message, e.g.
#        "gh pr create" or "gh pr edit".
#   $@ - the original argv to scan (caller forwards "$@").
lint_pr_body_or_die() {
  local subcmd_label="$1"; shift
  local body_content=""
  local body_source=""
  local body_skip_reason=""
  local prev_arg=""
  local arg path
  for arg in "$@"; do
    case "$prev_arg" in
      --body)
        body_content="$arg"
        body_source="--body"
        ;;
      --body-file)
        if [ "$arg" = "-" ]; then
          body_skip_reason="--body-file - (stdin; cannot safely re-read)"
        elif [ -f "$arg" ]; then
          body_content="$(cat "$arg")"
          body_source="--body-file $arg"
        else
          body_skip_reason="--body-file $arg (file not found)"
        fi
        ;;
    esac
    case "$arg" in
      --body=*)
        body_content="${arg#--body=}"
        body_source="--body="
        ;;
      --body-file=*)
        path="${arg#--body-file=}"
        if [ "$path" = "-" ]; then
          body_skip_reason="--body-file=- (stdin; cannot safely re-read)"
        elif [ -f "$path" ]; then
          body_content="$(cat "$path")"
          body_source="--body-file=$path"
        else
          body_skip_reason="--body-file=$path (file not found)"
        fi
        ;;
    esac
    prev_arg="$arg"
  done

  local lint_path="$HOME/.copilot/skills/validate-style/lint.py"
  if [ -n "$body_content" ] && [ -x "$(command -v python3)" ] && [ -f "$lint_path" ]; then
    # Determine if the target repo is public. If so, enable --check-visibility
    # to block references to private/internal repos in the PR body.
    local visibility_flag=""
    local target_repo=""
    # Try -R/--repo flag first
    local prev=""
    for arg in "$@"; do
      case "$prev" in
        -R|--repo) target_repo="$arg" ;;
      esac
      case "$arg" in
        --repo=*) target_repo="${arg#--repo=}" ;;
        -R=*) target_repo="${arg#-R=}" ;;
      esac
      prev="$arg"
    done
    # Fall back to current repo from git remote
    if [ -z "$target_repo" ] && git rev-parse --show-toplevel >/dev/null 2>&1; then
      target_repo="$("$REAL_GH" repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
    fi
    if [ -n "$target_repo" ]; then
      local repo_vis=""
      repo_vis="$("$REAL_GH" api "repos/$target_repo" --jq .visibility 2>/dev/null || true)"
      if [ "$repo_vis" = "public" ]; then
        visibility_flag="--check-visibility"
      fi
    fi

    local lint_output=""
    if ! lint_output="$(printf '%s' "$body_content" | python3 "$lint_path" $visibility_flag - 2>&1)"; then
      cat >&2 <<EOF
gh-guard: \`$subcmd_label\` blocked by validate-style.

The PR body (from $body_source) failed Zack's hard writing-style rules. Fix the
violations below and retry. See ~/.copilot/skills/validate-style/SKILL.md for
the full rule catalog, or run the linter directly to iterate:

  python3 $lint_path $visibility_flag - <<<"<draft body>"

Violations:

$lint_output
EOF
      exit 1
    fi
  elif [ -n "$body_skip_reason" ]; then
    echo "gh-guard: skipping validate-style lint ($body_skip_reason)." >&2
  fi
}

# Minimum accepted size (bytes) for each PR-readiness marker. These MUST match
# the per-kind thresholds in bin/pr-marker so the writer and the gate agree.
CODE_REVIEW_MIN_BYTES=200
PLAN_MIN_BYTES=120
DEMO_MIN_BYTES=120
PR_REVIEW_MIN_BYTES=120

# Minimum distinct models a review marker (plan, code-review, pr-review) must
# declare in its `<!-- reviewed-by-models: a, b, c -->` header. MUST match
# bin/pr-marker's MIN_MODELS so the writer and the gate agree. The demo marker
# is exempt (it is not a multi-model review).
MIN_REVIEW_MODELS=3

# count_review_models <path>
# Echo the number of distinct (case-insensitive) models declared in the marker's
# reviewed-by-models header, or 0 if there is none. Parses the same header
# format bin/pr-marker writes: splits the inner list on commas, trims each name,
# lowercases, drops empties, and dedupes. The header is not position-pinned, so
# `sed` scans every line and `head -n1` takes the first match.
#
# The whole pipeline is captured into a variable so the fallback REPLACES the
# result rather than appending a second value: under `set -o pipefail` an
# earlier fix used `grep -v '^$'`, which exits non-zero when it filters every
# line (a header-less marker), tripping pipefail AFTER `wc -l` had already
# printed 0 and yielding the two-line string "0\n0" that made the `-lt` test
# error out and the gate FAIL OPEN. Empty lines are now dropped with
# `sed '/^$/d'` (always exit 0), and the substitution result is defaulted to 0.
count_review_models() {
  local path="$1" count
  count="$(
    sed -n 's/^<!-- reviewed-by-models: \(.*\) -->$/\1/p' "$path" 2>/dev/null \
      | head -n1 \
      | tr ',' '\n' \
      | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
      | tr '[:upper:]' '[:lower:]' \
      | sed '/^$/d' \
      | sort -u \
      | wc -l \
      | tr -d ' '
  )" || count=""
  printf '%s' "${count:-0}"
}

# check_marker <path> <min_bytes>
# Succeeds (returns 0) when the marker file exists and is at least <min_bytes>
# bytes, so a bare `touch` never satisfies the gate. Always called from an `if`
# so `return 1` does not trip `set -e`.
check_marker() {
  local path="$1" min="$2" size
  [ -f "$path" ] || return 1
  size="$(wc -c < "$path" 2>/dev/null | tr -d ' ' || echo 0)"
  [ "${size:-0}" -ge "$min" ]
}

# eval_marker <label> <path> <min_bytes> <pinned:0|1> <requires_models:0|1>
# Appends a status line and clears marker_all_ok (both globals) when a marker
# fails. Takes separate positional args rather than a delimiter-packed spec so a
# branch name or path containing any character, including `|`, parses correctly.
# A pinned marker records the reviewed commit on its first line
# (`<!-- reviewed-commit: <sha> -->`); it is rejected as STALE once HEAD moves
# past that commit, so a review that never saw the shipping diff cannot pass.
# A requires_models marker must declare >= MIN_REVIEW_MODELS distinct models in
# its reviewed-by-models header, so a single-pass self-review cannot pass a gate
# meant to require a multi-model review. The reviewed-commit and
# reviewed-by-models formats MUST match bin/pr-marker's REVIEWED_COMMIT_PREFIX
# and REVIEWED_MODELS_PREFIX.
eval_marker() {
  local label="$1" path="$2" min="$3" pinned="$4" requires_models="${5:-0}"
  if ! check_marker "$path" "$min"; then
    marker_all_ok=0
    status_lines="${status_lines}  [ MISSING ] ${label} -> ${path} (>= ${min} bytes)"$'\n'
    return
  fi
  if [ "$pinned" = "1" ]; then
    local recorded current
    recorded="$(sed -n '1s/^<!-- reviewed-commit: \([0-9a-f]\{7,40\}\) -->$/\1/p' "$path" 2>/dev/null || true)"
    current="$(git rev-parse HEAD 2>/dev/null || true)"
    if [ -z "$recorded" ] || [ -z "$current" ] || [ "$recorded" != "$current" ]; then
      marker_all_ok=0
      status_lines="${status_lines}  [ STALE   ] ${label} -> ${path} (reviewed ${recorded:-none}, HEAD ${current:-none}; re-review and rewrite)"$'\n'
      return
    fi
  fi
  if [ "$requires_models" = "1" ]; then
    local models_count
    models_count="$(count_review_models "$path")"
    if [ "${models_count:-0}" -lt "$MIN_REVIEW_MODELS" ]; then
      marker_all_ok=0
      status_lines="${status_lines}  [ FEW-MODELS ] ${label} -> ${path} (declares ${models_count:-0} of >= ${MIN_REVIEW_MODELS} models; re-run a multi-model review and rewrite with pr-marker --models a,b,c)"$'\n'
      return
    fi
  fi
  status_lines="${status_lines}  [ ok      ] ${label} -> ${path}"$'\n'
}

# --- gh pr ready ---------------------------------------------------------
if [ "$is_pr_ready" = "1" ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    echo "About to run: gh $*" >&2
    echo "This marks the PR ready for review and notifies reviewers." >&2
    printf "Continue? [y/N] " >&2
    read -r ans
    case "$ans" in
      y|Y|yes|YES|Yes) ;;
      *) echo "Aborted." >&2; exit 1 ;;
    esac
  else
    if [ "${ZACK_CONFIRMED_PR_READY:-}" != "1" ]; then
      cat >&2 <<'EOF'
gh-guard: `gh pr ready` blocked.

Reason: Zack's rule is "never mark draft PRs ready without explicit ask."
This wrapper prevents accidental notifications to reviewers from automation.

If Zack has explicitly confirmed that this PR should be marked ready, set:

  ZACK_CONFIRMED_PR_READY=1 gh pr ready <args>

Otherwise, leave the PR as draft and ask Zack first.
EOF
      exit 1
    fi
  fi
fi

# --- gh pr create --------------------------------------------------------
if [ "$is_pr_create" = "1" ]; then
  # Lint the PR body via the validate-style skill before doing anything else.
  # This catches violations of Zack's hard rules (em-dashes, "per" misuse,
  # "This PR" as a sentence subject, subjectless action-verb bullets, etc.)
  # before the PR exists on GitHub, where a body edit would be needed to fix
  # them. The lint runs for both TTY and non-TTY paths -- the rule is hard.
  lint_pr_body_or_die "gh pr create" "$@"

  # Try to resolve the current repo and branch so we can check the per-branch
  # review marker. If either lookup fails, the marker check is skipped and we
  # fall back to the env var alone.
  repo_root=""
  branch=""
  git_dir=""
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    # Use symbolic-ref (not rev-parse --abbrev-ref) so the branch name matches
    # what bin/pr-marker resolves; the two must agree or a marker written by
    # pr-marker lands where the gate does not look. On a detached HEAD this
    # exits non-zero and leaves branch empty, so in_repo stays 0 (env-var path).
    branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
    # --absolute-git-dir returns the per-worktree gitdir, so this works for
    # both plain checkouts (`<repo>/.git`) and worktrees (where `<repo>/.git`
    # is a gitlink file, not a directory).
    git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
  fi

  marker_all_ok=0
  in_repo=0
  status_lines=""
  if [ -n "$repo_root" ] && [ -n "$branch" ] && [ "$branch" != "HEAD" ] && [ -n "$git_dir" ]; then
    in_repo=1
    # Encode `/` and `%` losslessly so each branch maps to one flat directory
    # name. `feat/foo` becomes `feat%2Ffoo`; a literal underscore branch like
    # `feat_foo` stays `feat_foo`. This MUST match bin/pr-marker's encode_branch
    # (asserted by bin/test_pr_marker.py).
    safe_branch="$(printf '%s' "$branch" | sed -e 's/%/%25/g' -e 's|/|%2F|g')"
    # Each branch gets its own directory with one file per kind, so branch `x`'s
    # plan marker cannot collide with branch `x.plan`'s code-review marker.
    marker_base="$git_dir/copilot-pr-review/$safe_branch"

    # Start optimistic; any failing eval_marker clears the flag. All four must
    # pass, so their order here is cosmetic (shown in workflow order).
    marker_all_ok=1
    eval_marker "plan review"          "$marker_base/plan.md"        "$PLAN_MIN_BYTES"        0 1
    eval_marker "code review"          "$marker_base/code-review.md" "$CODE_REVIEW_MIN_BYTES" 1 1
    eval_marker "demo/before-after"    "$marker_base/demo.md"        "$DEMO_MIN_BYTES"        0 0
    eval_marker "PR-description review" "$marker_base/pr-review.md"  "$PR_REVIEW_MIN_BYTES"   0 1
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    echo "About to run: gh $*" >&2
    if [ "$marker_all_ok" = "1" ]; then
      echo "All four PR-readiness markers present (plan, code, demo, PR-description)." >&2
    else
      echo "Missing PR-readiness markers (Zack's staged change workflow):" >&2
      printf '%s' "$status_lines" >&2
      echo "Run the plan review, code review, demo/before-after capture, and PR-description review, then write each with pr-marker." >&2
    fi
    printf "Continue? [y/N] " >&2
    read -r ans
    case "$ans" in
      y|Y|yes|YES|Yes) ;;
      *) echo "Aborted." >&2; exit 1 ;;
    esac
  else
    pass=0
    if [ "$in_repo" = "1" ]; then
      # Inside a resolvable repo: require ALL four markers and the env var.
      if [ "$marker_all_ok" = "1" ] && [ "${ZACK_CONFIRMED_PR_CREATE:-}" = "1" ]; then
        pass=1
      fi
    else
      # Outside a resolvable repo (no checkout, detached HEAD): no marker path
      # can be derived, so the env var alone is the only available signal.
      if [ "${ZACK_CONFIRMED_PR_CREATE:-}" = "1" ]; then
        pass=1
      fi
    fi

    if [ "$pass" = "0" ]; then
      if [ "$in_repo" = "1" ]; then
        cat >&2 <<EOF
gh-guard: \`gh pr create\` blocked.

Reason: Zack's staged change workflow requires four artifacts before a PR is
opened: a multi-model review of the PLAN, a multi-model review of the CODE, a
demo + before/after capture (or an explicit N/A justification), and a
multi-model review of the PR DESCRIPTION. Each is a marker file under
$git_dir/copilot-pr-review/.

Marker status this invocation:

$status_lines
Fill each missing marker by piping the synthesized content through pr-marker
(on PATH via ~/.local/bin, or ~/repos/dotfiles/bin/pr-marker), which writes to
the correct per-branch path:

  <synthesized plan review>        | pr-marker write plan --models a,b,c -
  <synthesized code review>        | pr-marker write code-review --models a,b,c -
  <demo summary + image/video paths, or N/A justification> | pr-marker write demo -
  <synthesized PR-description review> | pr-marker write pr-review --models a,b,c -

The plan, code-review, and PR-description markers each require a multi-model
review: pass >=3 distinct models via --models (e.g. --models
opus-4.8,sonnet-4.6,gpt-5.5). A "1-MODEL" status above means the marker declares
fewer than 3 models; re-run the review across different models and rewrite it.

For the demo marker, use the record-demo skill (codespace + playwright,
before/after images). If the change has no visual surface, the demo marker may
record an explicit "N/A - no visual surface" justification plus an alternative
visual aid (table / mermaid / terminal output).

A STALE code-review marker means HEAD moved since the review was written (the
review never saw the shipping commits). Re-run the code review and rewrite it
with \`pr-marker write code-review -\` so it re-pins to the current HEAD.

Then set the explicit confirmation env var in the same invocation:

  ZACK_CONFIRMED_PR_CREATE=1 gh pr create <args>

Both all four markers AND the env var are required inside a git checkout.
ZACK_CONFIRMED_PR_CREATE='${ZACK_CONFIRMED_PR_CREATE:-}'.
EOF
      else
        cat >&2 <<EOF
gh-guard: \`gh pr create\` blocked.

Reason: Zack's staged change workflow requires plan review, code review,
demo/before-after capture, and PR-description review before a PR is opened.
This wrapper prevents skipping those steps from automation.

You appear to be running outside a resolvable git checkout (no repo root or
branch detectable; branch was '${branch:-}'). The marker-file checks are
unavailable, so the only signal is the env var. Set it explicitly:

  ZACK_CONFIRMED_PR_CREATE=1 gh pr create <args>
EOF
      fi
      exit 1
    fi
  fi
fi

# --- gh pr edit ----------------------------------------------------------
if [ "$is_pr_edit" = "1" ]; then
  # `gh pr edit` can mutate any of: title, body, labels, reviewers, base,
  # milestone, projects, assignees. We only care about body changes here --
  # the lint runs against the new body content and blocks if it would
  # introduce style violations. Edits that touch only non-body fields fall
  # through silently because `lint_pr_body_or_die` short-circuits when no
  # body flag is present.
  #
  # This closes the loop where post-create body edits would otherwise bypass
  # the `pr create` lint -- PR #19 of zkoppert/zkoppert.github.io was edited
  # four times after creation, and each edit re-introduced first-person rule
  # violations that the original create-time lint never had a chance to see.
  lint_pr_body_or_die "gh pr edit" "$@"
fi

exec "$REAL_GH" "$@"
