#!/bin/bash
# Global pre-push hook: enforce Zack's personal push policies.
#
# Install by setting: git config --global core.hooksPath ~/repos/dotfiles/git-hooks
#
# How it works:
#   1. Determines the remote repo (owner/repo) from the push URL.
#   2. Blocks prospective PRs over 800 additions in github/github and
#      github/github-ui.
#   3. Checks the repo's visibility via `gh api`.
#   4. If public, extracts all commit messages being pushed and runs them
#      through validate-style with --check-visibility.
#   5. Blocks the push if any private repo references are found.
#
# Overrides:
#   SKIP_PREPUSH_VISIBILITY=1 skips only the public-repository visibility lint.
#   ZACK_CONFIRMED_LARGE_PR=1 permits an oversized PR after Zack approves it.

set -euo pipefail

LINT_PATH="$HOME/.copilot/skills/validate-style/lint.py"
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SIZE_GUARD="$HOOK_DIR/../bin/pr-size-guard"
push_updates="$(cat)"

github_repo_from_url() {
  local url
  url="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  local repository=""
  case "$url" in
    git@github.com:*) repository="${url#git@github.com:}" ;;
    ssh://git@github.com/*) repository="${url#ssh://git@github.com/}" ;;
    ssh://git@github.com:[0-9]*/*)
      repository="${url#ssh://git@github.com:}"
      repository="${repository#*/}"
      ;;
    https://github.com/*) repository="${url#https://github.com/}" ;;
    https://github.com:[0-9]*/*)
      repository="${url#https://github.com:}"
      repository="${repository#*/}"
      ;;
    https://*@github.com/*) repository="${url#https://*@github.com/}" ;;
    http://github.com/*) repository="${url#http://github.com/}" ;;
    git://github.com/*) repository="${url#git://github.com/}" ;;
    ssh://git@ssh.github.com:[0-9]*/*)
      repository="${url#ssh://git@ssh.github.com:}"
      repository="${repository#*/}"
      ;;
  esac
  repository="${repository%.git}"
  printf '%s' "$repository" | tr '[:upper:]' '[:lower:]'
}

run_repository_pre_push() {
  local common_dir local_hook
  common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
  [ -n "$common_dir" ] || return 0
  if [[ "$common_dir" != /* ]]; then
    common_dir="$(pwd)/$common_dir"
  fi
  local_hook="$common_dir/hooks/pre-push"
  if [ -x "$local_hook" ] && [ ! "$local_hook" -ef "$0" ]; then
    printf '%s\n' "$push_updates" | "$local_hook" "$@"
  fi
}

# $1 = remote name, $2 = remote URL
remote_name="${1:-}"
remote_url="${2:-}"
if [ -z "$remote_url" ]; then
  run_repository_pre_push "$@"
  exit 0
fi

# Extract owner/repo from the remote URL
# Handles: git@github.com:owner/repo.git, https://github.com/owner/repo.git
owner_repo="$(github_repo_from_url "$remote_url")"

if [ -z "$owner_repo" ]; then
  run_repository_pre_push "$@"
  exit 0
fi

is_size_target=0
size_repo="$owner_repo"
size_remote="$remote_name"
case "$owner_repo" in
  github/github|github/github-ui) is_size_target=1 ;;
esac
if [ "$is_size_target" = "0" ]; then
  while IFS= read -r candidate_remote; do
    candidate_url="$(git config --get "remote.$candidate_remote.url" 2>/dev/null || true)"
    candidate_repo="$(github_repo_from_url "$candidate_url")"
    if [ -n "$candidate_repo" ]; then
      case "$candidate_repo" in
        github/github|github/github-ui)
          is_size_target=1
          size_repo="$candidate_repo"
          size_remote="$candidate_remote"
          break
          ;;
      esac
    fi
  done < <(git remote 2>/dev/null || true)
fi
if [ "$is_size_target" = "0" ]; then
  case "${owner_repo#*/}" in
    github)
      is_size_target=1
      size_repo="github/github"
      size_remote=""
      ;;
    github-ui)
      is_size_target=1
      size_repo="github/github-ui"
      size_remote=""
      ;;
  esac
fi

repo_vis=""
if [ "${SKIP_PREPUSH_VISIBILITY:-}" != "1" ] &&
   command -v gh >/dev/null 2>&1 &&
   command -v python3 >/dev/null 2>&1 &&
   [ -f "$LINT_PATH" ]; then
  repo_vis="$(gh api "repos/$owner_repo" --jq .visibility 2>/dev/null || true)"
fi

# Read stdin for the ref updates being pushed
# Format: <local ref> <local sha> <remote ref> <remote sha>
violations_found=0
while read -r _ local_sha remote_ref remote_sha; do
  # Skip delete pushes
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$is_size_target" = "1" ] && [[ "$remote_ref" == refs/heads/* ]]; then
    if ! command -v python3 >/dev/null 2>&1 || [ ! -x "$SIZE_GUARD" ]; then
      echo "pre-push: blocked $owner_repo because pr-size-guard is unavailable." >&2
      exit 1
    fi
    branch="${remote_ref#refs/heads/}"
    if [ -z "$size_remote" ]; then
      echo "pre-push: blocked fork-only push for $size_repo." >&2
      echo "Add a remote for the canonical repository so the PR base can be measured." >&2
      exit 1
    fi
    python3 "$SIZE_GUARD" \
      --repo "$size_repo" \
      --remote "$size_remote" \
      --head-owner "${owner_repo%%/*}" \
      --branch "$branch" \
      --source "$local_sha" \
      --context push \
      --check-open-pr || exit $?
  fi

  if [ "$repo_vis" != "public" ]; then
    continue
  fi

  # Determine the range of commits being pushed
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch - check all commits not on any other remote branch
    range="$local_sha --not --remotes=origin"
  else
    range="$remote_sha..$local_sha"
  fi

  # Extract commit messages
  commit_messages="$(git log --format="%H %s%n%b" $range 2>/dev/null || true)"
  if [ -z "$commit_messages" ]; then
    continue
  fi

  # Run through validate-style with visibility checking
  lint_output=""
  if ! lint_output="$(printf '%s' "$commit_messages" | python3 "$LINT_PATH" --check-visibility - 2>&1)"; then
    if [ "$violations_found" = "0" ]; then
      echo "" >&2
      echo "pre-push: BLOCKED - commit messages reference private/internal repos" >&2
      echo "          in a push to public repo '$owner_repo'." >&2
      echo "" >&2
    fi
    echo "$lint_output" >&2
    echo "" >&2
    echo "Fix: amend the commit message(s) to remove or anonymize private repo references." >&2
    echo "     Use 'an internal repo' or 'a private service' instead of the repo name." >&2
    echo "Skip: SKIP_PREPUSH_VISIBILITY=1 git push (use sparingly)" >&2
    echo "" >&2
    violations_found=1
  fi
done <<< "$push_updates"

if [ "$violations_found" = "1" ]; then
  exit 1
fi

run_repository_pre_push "$@"
exit 0
